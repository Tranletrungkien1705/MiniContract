@*
    Port 1:1 màn NGUỒN: 2020.6.QContract/Dev/V10/idn.Skycic.QContract.Website/Views/Contract_Contract/BindData_Contract_Party_Info.cshtml
    — bảng Contract_ContractParty.
    Tập cột của lưới lấy từ objCommon của renderContractParty_20221106 (nguồn :263-292);
    ý nghĩa từng cột ghi ở Models/Entities.cs (mỗi cột dẫn Contract_ContractParty.cs:<dòng>).
    Khác nguồn có chủ đích: nguồn dựng cột ĐỘNG theo cấu hình ContractParty_User_Excel (nguồn :46-59)
    nên tiêu đề cột do dữ liệu quyết định; đích render cột TĨNH đúng bộ cột ở :263-292 — xem mục 5 báo cáo.
*@
@model Contract
@{
    ViewData["Title"] = $"Các bên ký kết — {Model.Code}";
    var rows = (List<ContractParty>)ViewBag.Rows;
    // Nguồn khóa lưới sau khi HĐ rời trạng thái nháp (disabledUpdate/disabled-fix — Update.cshtml:154-173)
    var khoa = Model.Status != ContractStatus.Draft;
}

<h1 class="h5 fw-bold mb-1">Các bên ký kết</h1>
<div class="text-muted small mb-3">(port 1:1 BindData_Contract_Party_Info.cshtml — Contract_ContractParty)</div>

<div class="card mb-3">
    <div class="card-body">
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item"><a class="nav-link" href="/Contract/Info/@Model.Id"><span class="badge bg-secondary me-1">1</span>Thông tin chung</a></li>
            <li class="nav-item"><a class="nav-link active" href="#"><span class="badge bg-secondary me-1">2</span>Các bên ký kết</a></li>
            <li class="nav-item"><a class="nav-link" href="/Contract/Detail/@Model.Id"><span class="badge bg-secondary me-1">3</span>Vị trí ký</a></li>
        </ul>

        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
            <div class="small text-muted">
                Số dòng: <b id="disp_contract_party_rowcount">@rows.Count</b> —
                bên tạo (PARTY_A / vai Bên A) bị loại khỏi lưới đúng như nguồn (BindData_Contract_Party_Info.cshtml:21).
            </div>
            @if (Model.FlagCheckOrderSign)
            {
                <span class="badge bg-warning text-dark">Có quy định thứ tự ký</span>
            }
        </div>

        @*
            Mỗi dòng lưới là 1 form riêng. Thẻ <form> phải nằm NGOÀI <table> (HTML không cho <form> trong <tr>);
            các ô nhập trong lưới trỏ về form của dòng bằng thuộc tính form="frmParty-<Id>".
        *@
        @foreach (var p in rows)
        {
            <form asp-action="PartyInfo" method="post" id="frmParty-@p.Id" hidden>
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="partyId" value="@p.Id" />
            </form>
        }

        @* Lưới cuộn ngang — nguồn bọc div style="overflow-x: auto" (:41) *@
        <div style="overflow-x:auto">
            <table class="table table-sm table-bordered align-middle" style="min-width:1700px">
                <thead>
                    <tr>
                        <th style="min-width:110px">Mã đối tác</th>
                        <th style="min-width:90px">Mã hệ thống</th>
                        <th style="min-width:180px">Tên đối tác <span class="text-danger">*</span></th>
                        <th style="min-width:110px">MST <span class="text-danger">*</span></th>
                        <th style="min-width:170px">Email người ký <span class="text-danger">*</span></th>
                        <th style="min-width:120px">Điện thoại</th>
                        <th style="min-width:120px">Di động</th>
                        <th style="min-width:120px">Facebook</th>
                        <th style="min-width:120px">ZaloUserID</th>
                        <th style="min-width:200px">Địa chỉ</th>
                        <th style="min-width:140px">Website</th>
                        <th style="min-width:130px">Số TK</th>
                        <th style="min-width:130px">Tên NH</th>
                        <th style="min-width:90px">Mã NH</th>
                        <th style="min-width:150px">Người đại diện</th>
                        <th style="min-width:130px">Chức vụ</th>
                        <th style="min-width:120px" class="text-end">Giá trị HĐ</th>
                        <th style="min-width:120px" class="text-end">Đã TT</th>
                        <th style="min-width:120px" class="text-end">Còn lại</th>
                        <th style="min-width:120px" class="text-end">Quy đổi</th>
                        <th style="min-width:90px">Trạng thái</th>
                        <th style="min-width:80px"></th>
                    </tr>
                </thead>
                <tbody id="list_contract_party">
                @foreach (var p in rows)
                {
                    var ro = (khoa || p.HasSigned) ? "readonly" : "";
                    <tr class="trdata">
                        <td><input form="frmParty-@p.Id" name="customerCode" class="form-control form-control-sm" value="@p.CustomerCode" @ro /></td>
                        <td><input form="frmParty-@p.Id" name="customerCodeSys" class="form-control form-control-sm" value="@p.CustomerCodeSys" @ro /></td>
                        <td><input form="frmParty-@p.Id" name="customerName" class="form-control form-control-sm" value="@(p.CustomerName ?? p.Name)" required @ro /></td>
                        <td><input form="frmParty-@p.Id" name="taxCode" class="form-control form-control-sm" value="@p.TaxCode" required @ro /></td>
                        <td><input form="frmParty-@p.Id" name="customerEmail" type="email" class="form-control form-control-sm" value="@p.Email" required @ro /></td>
                        <td><input form="frmParty-@p.Id" name="customerPhoneNo" class="form-control form-control-sm" value="@p.Phone" @ro /></td>
                        <td><input form="frmParty-@p.Id" name="customerMobilePhone" class="form-control form-control-sm" value="@p.CustomerMobilePhone" @ro /></td>
                        <td><input form="frmParty-@p.Id" name="facebook" class="form-control form-control-sm" value="@p.Facebook" @ro /></td>
                        <td><input form="frmParty-@p.Id" name="zaloUserID" class="form-control form-control-sm" value="@p.ZaloUserID" @ro /></td>
                        <td><input form="frmParty-@p.Id" name="customerAddress" class="form-control form-control-sm" value="@p.CustomerAddress" @ro /></td>
                        <td><input form="frmParty-@p.Id" name="customerWebsite" class="form-control form-control-sm" value="@p.CustomerWebsite" @ro /></td>
                        <td><input form="frmParty-@p.Id" name="bankAccountNo" class="form-control form-control-sm" value="@p.BankAccountNo" @ro /></td>
                        <td><input form="frmParty-@p.Id" name="bankName" class="form-control form-control-sm" value="@p.BankName" @ro /></td>
                        <td><input form="frmParty-@p.Id" name="bankCode" class="form-control form-control-sm" value="@p.BankCode" @ro /></td>
                        <td><input form="frmParty-@p.Id" name="representName" class="form-control form-control-sm" value="@p.RepresentName" @ro /></td>
                        <td><input form="frmParty-@p.Id" name="representPosition" class="form-control form-control-sm" value="@p.RepresentPosition" @ro /></td>
                        <td><input form="frmParty-@p.Id" name="valContract" type="number" step="0.01" class="form-control form-control-sm text-end" value="@p.ValContract" @ro /></td>
                        @* Ba ô tiền dưới readonly đúng như nguồn (Contract_Contract_Info.cshtml:621 nhập, :611/:630 readonly).
                           data-col ghi tên cột nguồn để truy vết cột nào hiển thị ở ô nào. *@
                        <td class="text-end small" data-col="ValPaymented">@p.ValPaymented.ToString("N2")</td>
                        <td class="text-end small bg-light" data-col="ValRemain">@p.ValRemain.ToString("N2")</td>
                        <td class="text-end small bg-light" data-col="ValExchange">@p.ValExchange.ToString("N2")</td>
                        <td class="small" data-col="ContractPartyStatus">
                            @* Nguồn để ô này ở hidden name="PartyCurStatus" (Contract_Contract_Info.cshtml) *@
                            <input form="frmParty-@p.Id" type="hidden" name="PartyCode" value="@(p.PartyCode ?? p.Id.ToString())" />
                            <input form="frmParty-@p.Id" type="hidden" name="PartyCurStatus" value="@p.ContractPartyStatus" />
                            @(p.ContractPartyStatus ?? (p.HasSigned ? "CONFIRMED" : "ONPROCESS"))
                        </td>
                        <td>
                            <button form="frmParty-@p.Id" class="btn btn-sm btn-primary w-100" @(ro == "readonly" ? "disabled" : "")>Lưu</button>
                        </td>
                    </tr>
                }
                @if (rows.Count == 0)
                {
                    <tr><td colspan="22" class="text-center text-muted py-4">Hợp đồng chưa có bên tham gia nào ngoài bên tạo.</td></tr>
                }
                </tbody>
            </table>
        </div>

        <div class="mt-3"><a href="/Contract/Detail/@Model.Id" class="btn btn-outline-secondary btn-sm">Quay lại chi tiết</a></div>
    </div>
</div>
