@model Contract
@{
    ViewData["Title"] = $"Hợp đồng {Model.Code}";
    var (st, css) = Ui.Status(Model.Status);
    bool canSign = Model.Status is ContractStatus.Sent or ContractStatus.PartiallySigned;
    var annexes = (List<Contract>)(ViewBag.Annexes ?? new List<Contract>());
    var history = (List<ContractHistory>)(ViewBag.History ?? new List<ContractHistory>());
    var elements = (List<ContractElement>)(ViewBag.Elements ?? new List<ContractElement>());
    var elStats = (ElementStats)(ViewBag.ElementStats ?? new ElementStats(0, 0, 0, 0, 0));
    bool canEditElements = Model.Status is not (ContractStatus.Completed or ContractStatus.Cancelled);
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h5 class="fw-bold mb-1">@Model.Title</h5>
                        <div class="text-muted small">Số @Model.Code · @(Model.Type?.Name ?? "—") · tạo @Model.CreatedAt.ToString("dd/MM/yyyy")</div>
                        @if (Model.IsAnnex)
                        {
                            <div class="mt-1"><span class="badge bg-info">Phụ lục</span> <span class="small text-muted">của hợp đồng gốc</span> <a href="/Contract/Detail/@Model.ParentContractId" class="small fw-semibold">@Model.ParentContractCode</a></div>
                        }
                    </div>
                    <span class="badge bg-@css fs-6">@st</span>
                </div>
                <div class="mb-2"><span class="text-muted small">Giá trị:</span> <b>@Model.Value.ToString("N0") đ</b></div>
                <div class="p-3 rounded" style="background:#f6faf9;white-space:pre-wrap">@Model.Body</div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Các bên & chữ ký</h6>
                @foreach (var p in Model.Parties.OrderBy(x => x.SignOrder))
                {
                    var sig = Model.Signatures.FirstOrDefault(s => s.PartyId == p.Id);
                    <div class="border rounded p-3 mb-2">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <span class="badge bg-secondary me-1">@Ui.Role(p.Role)</span>
                                <b>@p.Name</b> @if (p.Email != null) { <span class="text-muted small">· @p.Email</span> }
                                @if (p.HasSigned)
                                {
                                    <div class="text-success small mt-1"><i class="bi bi-patch-check-fill me-1"></i>Đã ký @(sig != null ? "bằng " + Ui.Method(sig.Method) : "") lúc @p.SignedAt?.ToString("dd/MM/yyyy HH:mm")
                                        @if (sig?.CertSubject != null) { <div class="text-muted" style="font-size:11px">CTS: @sig.CertSubject</div> }
                                        @if (sig?.SignatureValue != null) { <div class="text-muted text-truncate" style="font-size:10px;max-width:420px" title="@sig.SignatureValue">Chữ ký: @sig.SignatureValue</div> }
                                    </div>
                                }
                                else { <span class="text-muted small ms-1">· chưa ký</span> }
                            </div>
                            @if (canSign && !p.HasSigned)
                            {
                                <div class="d-flex gap-2 align-items-center">
                                    <form asp-action="SignCks" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="partyId" value="@p.Id" />
                                        <button class="btn btn-sm btn-primary"><i class="bi bi-pen me-1"></i>Ký số (CKS)</button>
                                    </form>
                                    <form asp-action="OtpGenerate" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="partyId" value="@p.Id" />
                                        <button class="btn btn-sm btn-outline-primary" title="Gửi OTP"><i class="bi bi-shield-lock"></i> OTP</button>
                                    </form>
                                    <form asp-action="SignOtp" method="post" class="d-inline d-flex gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="partyId" value="@p.Id" />
                                        <input name="otp" class="form-control form-control-sm" style="width:90px" placeholder="mã OTP" />
                                        <button class="btn btn-sm btn-outline-success">Xác nhận</button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (!Model.IsAnnex)
        {
            <div class="card mt-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0">Phụ lục hợp đồng <span class="badge bg-secondary">@annexes.Count</span></h6>
                        <a href="/Contract/CreateAnnex/@Model.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Thêm phụ lục</a>
                    </div>
                    @if (annexes.Count == 0)
                    {
                        <div class="text-muted small">Chưa có phụ lục nào.</div>
                    }
                    else
                    {
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Số PL</th><th>Tiêu đề</th><th class="text-end">Giá trị</th><th>Ký</th><th>Trạng thái</th></tr></thead>
                            <tbody>
                            @foreach (var a in annexes)
                            {
                                var (ast, acss) = Ui.Status(a.Status);
                                <tr style="cursor:pointer" onclick="location.href='/Contract/Detail/@a.Id'">
                                    <td class="fw-semibold">@a.Code</td>
                                    <td>@a.Title</td>
                                    <td class="text-end">@a.Value.ToString("N0")</td>
                                    <td class="small">@a.SignedCount/@a.Parties.Count</td>
                                    <td><span class="badge bg-@acss">@ast</span></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-vector-pen me-1"></i>Ô ký trên hợp đồng <span class="badge bg-secondary">@elements.Count</span></h6>
                    <div class="small text-muted">
                        Đã ký <b>@elStats.Signed/@elStats.Total</b>
                        · <span class="badge bg-primary">Điện tử @elStats.Electronic</span>
                        <span class="badge bg-info">Ký tắt @elStats.Short</span>
                        <span class="badge bg-success">Ký số @elStats.Digital</span>
                    </div>
                </div>
                @if (elements.Count == 0)
                {
                    <div class="text-muted small">Chưa có ô ký nào.</div>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Tên ô</th><th>Loại</th><th>Bên</th><th>Trang / vị trí</th><th>Trạng thái</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var el in elements)
                        {
                            <tr>
                                <td class="fw-semibold">@el.ElementName<div class="text-muted" style="font-size:11px">@el.ElementCode</div></td>
                                <td><span class="badge bg-@(el.Type == ElementType.Digital ? "success" : el.Type == ElementType.Short ? "info" : "primary")">@el.TypeLabel</span></td>
                                <td class="small">@(el.Party?.Name ?? "—")</td>
                                <td class="small text-muted">tr.@el.PageIdx · (@el.ElementX.ToString("0"),@el.ElementY.ToString("0")) @el.ElementWidth.ToString("0")×@el.ElementHeight.ToString("0")</td>
                                <td>
                                    @if (el.IsSigned)
                                    {
                                        <span class="text-success small"><i class="bi bi-patch-check-fill me-1"></i>@el.SignerName · @el.SignedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                                        @if (el.SignFrom != null) { <div class="text-muted" style="font-size:11px">từ @el.SignFrom @(el.ElementIP != null ? "· " + el.ElementIP : "")</div> }
                                    }
                                    else { <span class="badge bg-warning text-dark">Chưa ký</span> }
                                </td>
                                <td class="text-end">
                                    @if (!el.IsSigned && canEditElements)
                                    {
                                        <form asp-action="SignElement" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="elementId" value="@el.Id" />
                                            <button class="btn btn-sm btn-outline-success"><i class="bi bi-pen me-1"></i>Ký ô</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                @if (canEditElements)
                {
                    <form asp-action="AddElement" method="post" class="row g-2 mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-4"><input name="elementName" class="form-control form-control-sm" placeholder="Tên ô ký (VD: Chữ ký Bên A)" required /></div>
                        <div class="col-md-2">
                            <select name="type" class="form-select form-select-sm">
                                <option value="0">Ký điện tử</option>
                                <option value="1">Ký tắt</option>
                                <option value="2">Ký số</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select name="partyId" class="form-select form-select-sm">
                                <option value="">— Bên sở hữu —</option>
                                @foreach (var p in Model.Parties.OrderBy(x => x.SignOrder))
                                {
                                    <option value="@p.Id">@Ui.Role(p.Role): @p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-1"><input name="pageIdx" type="number" value="1" min="1" class="form-control form-control-sm" title="Trang" /></div>
                        <div class="col-md-1"><input name="elementX" type="number" value="0" class="form-control form-control-sm" title="X" /></div>
                        <div class="col-md-1"><input name="elementY" type="number" value="0" class="form-control form-control-sm" title="Y" /></div>
                        <input type="hidden" name="elementWidth" value="120" />
                        <input type="hidden" name="elementHeight" value="40" />
                        <div class="col-12"><button class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Thêm ô ký</button></div>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Thao tác</h6>
                <div class="mb-2 small text-muted">Tiến độ ký: <b>@Model.SignedCount/@Model.Parties.Count</b></div>
                <div class="progress mb-3" style="height:8px">
                    <div class="progress-bar bg-success" style="width:@(Model.Parties.Count == 0 ? 0 : Model.SignedCount * 100 / Model.Parties.Count)%"></div>
                </div>

                @if (Model.Status == ContractStatus.Draft)
                {
                    <form asp-action="Send" method="post" class="mb-2">
                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-primary w-100"><i class="bi bi-send me-1"></i>Gửi các bên ký</button>
                    </form>
                }
                <a href="/Contract/Pdf/@Model.Id" class="btn btn-outline-primary w-100 mb-2" target="_blank"><i class="bi bi-file-pdf me-1"></i>Tải bản thể hiện (PDF)</a>
                @if (!Model.IsAnnex)
                {
                    <a href="/Contract/CreateAnnex/@Model.Id" class="btn btn-outline-info w-100 mb-2"><i class="bi bi-file-earmark-plus me-1"></i>Tạo phụ lục</a>
                }
                @if (Model.Status != ContractStatus.Completed && Model.Status != ContractStatus.Cancelled)
                {
                    <form asp-action="Cancel" method="post" onsubmit="return confirm('Hủy hợp đồng này?')">
                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-outline-danger w-100"><i class="bi bi-x-circle me-1"></i>Hủy hợp đồng</button>
                    </form>
                }
                @if (Model.Status == ContractStatus.Completed)
                {
                    <div class="alert alert-success small mb-0"><i class="bi bi-check-circle me-1"></i>Hoàn tất lúc @Model.CompletedAt?.ToString("dd/MM/yyyy HH:mm") — đủ chữ ký các bên.</div>
                }
            </div>
        </div>
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-clock-history me-1"></i>Nhật ký thao tác <span class="badge bg-secondary">@history.Count</span></h6>
            @if (history.Count == 0)
            {
                <div class="text-muted small">Chưa có thao tác nào.</div>
            }
            else
            {
                <ul class="list-unstyled small mb-0">
                    @foreach (var h in history)
                    {
                        var (ht, hcss, hicon) = Ui.Action(h.Action);
                        <li class="mb-2 d-flex gap-2">
                            <i class="bi @hicon text-@hcss" style="font-size:12px"></i>
                            <div>
                                <span class="badge bg-@hcss">@ht</span>
                                <span class="ms-1">@h.Description</span>
                                <div class="text-muted" style="font-size:11px">@h.Actor · @h.At.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </li>
                    }
                </ul>
            }
            <form asp-action="AddRemark" method="post" class="mt-3 d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input name="remark" class="form-control form-control-sm" placeholder="Ghi chú xử lý…" />
                <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-chat-left-text"></i></button>
            </form>
        </div></div>
    </div>
</div>
