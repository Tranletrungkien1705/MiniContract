@model Contract
@{
    ViewData["Title"] = $"Hợp đồng {Model.Code}";
    var (st, css) = Ui.Status(Model.Status);
    bool canSign = Model.Status is ContractStatus.Sent or ContractStatus.PartiallySigned;
    var annexes = (List<Contract>)(ViewBag.Annexes ?? new List<Contract>());
    var history = (List<ContractHistory>)(ViewBag.History ?? new List<ContractHistory>());
    var elements = (List<ContractElement>)(ViewBag.Elements ?? new List<ContractElement>());
    var elStats = (ElementStats)(ViewBag.ElementStats ?? new ElementStats(0, 0, 0, 0, 0));
    var checkers = (List<ContractChecker>)(ViewBag.Checkers ?? new List<ContractChecker>());
    var ckStats = (CheckerStats)(ViewBag.CheckerStats ?? new CheckerStats(0, 0, 0, CheckerStatus.None));
    var apStats = (ApproveStats)(ViewBag.ApproveStats ?? new ApproveStats(0, 0, false, null, null));
    var userAssignments = (List<ContractUserInContract>)(ViewBag.UserAssignments ?? new List<ContractUserInContract>());
    var signers = (List<ContractSigner>)(ViewBag.Signers ?? new List<ContractSigner>());
    var sgStats = (SignerStats)(ViewBag.SignerStats ?? new SignerStats(0, 0, 0, 0));
    var sendHistory = (List<ContractSendHist>)(ViewBag.SendHistory ?? new List<ContractSendHist>());
    var verifyOtps = (List<ContractVerifyOtp>)(ViewBag.VerifyOtps ?? new List<ContractVerifyOtp>());
    var psStats = (PartySignStats)(ViewBag.PartySignStats ?? new PartySignStats(0, 0, 0, false));
    var details = (List<ContractDetail>)(ViewBag.Details ?? new List<ContractDetail>());
    var dtStats = (DetailStats)(ViewBag.DetailStats ?? new DetailStats(0, 0, 0, 0, 0));
    var attributes = (List<ContractAttribute>)(ViewBag.Attributes ?? new List<ContractAttribute>());
    var attributeDetails = (List<ContractAttributeDtl>)(ViewBag.AttributeDetails ?? new List<ContractAttributeDtl>());
    var attributeMasters = (List<AttributeContract>)(ViewBag.AttributeMasters ?? new List<AttributeContract>());
    var partyInfoStats = (PartyInfoStats)(ViewBag.PartyInfoStats ?? new PartyInfoStats(0, 0, 0));
    bool canEditElements = Model.Status is not (ContractStatus.Completed or ContractStatus.Cancelled);
    bool canCheck = Model.Status is not (ContractStatus.Completed or ContractStatus.Cancelled);
    bool canApprove = Model.Status is not (ContractStatus.Completed or ContractStatus.Cancelled or ContractStatus.Finished) && !Model.IsApproved;
    bool canAssign = Model.Status is not (ContractStatus.Cancelled or ContractStatus.Finished);
    bool canSend = Model.Status is not (ContractStatus.Cancelled or ContractStatus.Finished);
    bool canCancelByParty = Model.Status is not (ContractStatus.Cancelled or ContractStatus.Finished) && Model.Parties.Any(p => !p.IsCancelled);
    bool canOtp = Model.Status is not (ContractStatus.Cancelled or ContractStatus.Finished);
    bool canSigner = Model.Status is not (ContractStatus.Cancelled or ContractStatus.Finished);
    bool canPartySign = Model.Status is ContractStatus.Sent or ContractStatus.PartiallySigned;
    bool canUpdAfterApproved = Model.Status is ContractStatus.Sent or ContractStatus.PartiallySigned or ContractStatus.Completed;
    bool canEditDetails = Model.Status is not (ContractStatus.Cancelled or ContractStatus.Finished);
    bool canEditAttributes = Model.Status is not (ContractStatus.Cancelled or ContractStatus.Finished);
    bool canEditParty = Model.Status is not (ContractStatus.Cancelled or ContractStatus.Finished);
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h5 class="fw-bold mb-1">@Model.Title</h5>
                        <div class="text-muted small">Số @Model.Code · @(Model.Type?.Name ?? "—") · tạo @Model.CreatedAt.ToString("dd/MM/yyyy")</div>
                        @if (Model.IsAnnex)
                        {
                            <div class="mt-1"><span class="badge bg-info">Phụ lục</span> <span class="small text-muted">của hợp đồng gốc</span> <a href="/Contract/Detail/@Model.ParentContractId" class="small fw-semibold">@Model.ParentContractCode</a></div>
                        }
                        @if (Model.IsFinished)
                        {
                            <div class="mt-1"><span class="badge bg-secondary">Đã kết thúc</span> <span class="small text-muted">lý do:</span> <b class="small">@Model.FinishReasonName</b> <span class="small text-muted">· @Model.FinishedAt?.ToString("dd/MM/yyyy HH:mm")</span></div>
                            @if (Model.FinishDescription != null) { <div class="small text-muted">@Model.FinishDescription</div> }
                        }
                    </div>
                    <span class="badge bg-@css fs-6">@st</span>
                </div>
                <div class="mb-2"><span class="text-muted small">Giá trị:</span> <b>@Model.Value.ToString("N0") đ</b></div>
                <div class="p-3 rounded" style="background:#f6faf9;white-space:pre-wrap">@Model.Body</div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Các bên & chữ ký</h6>
                @foreach (var p in Model.Parties.OrderBy(x => x.SignOrder))
                {
                    var sig = Model.Signatures.FirstOrDefault(s => s.PartyId == p.Id);
                    <div class="border rounded p-3 mb-2">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <span class="badge bg-secondary me-1">@Ui.Role(p.Role)</span>
                                <b>@p.Name</b> @if (p.Email != null) { <span class="text-muted small">· @p.Email</span> }
                                @if (p.IsCancelled)
                                {
                                    <span class="badge bg-dark ms-1">Đã hủy</span>
                                    <div class="text-danger small mt-1"><i class="bi bi-person-x me-1"></i>Hủy bởi @p.CancelledBy lúc @p.CancelledAt?.ToString("dd/MM/yyyy HH:mm")@(p.Remark != null ? " — " + p.Remark : "")</div>
                                }
                                @if (p.HasSigned)
                                {
                                    <div class="text-success small mt-1"><i class="bi bi-patch-check-fill me-1"></i>Đã ký @(sig != null ? "bằng " + Ui.Method(sig.Method) : "") lúc @p.SignedAt?.ToString("dd/MM/yyyy HH:mm")
                                        @if (sig?.CertSubject != null) { <div class="text-muted" style="font-size:11px">CTS: @sig.CertSubject</div> }
                                        @if (sig?.SignatureValue != null) { <div class="text-muted text-truncate" style="font-size:10px;max-width:420px" title="@sig.SignatureValue">Chữ ký: @sig.SignatureValue</div> }
                                    </div>
                                }
                                else { <span class="text-muted small ms-1">· chưa ký</span> }
                                @if (!p.IsCancelled && p.Remark != null)
                                {
                                    <div class="text-muted small mt-1"><i class="bi bi-chat-left-text me-1"></i>Ghi chú: @p.Remark</div>
                                }
                            </div>
                            @if (canSign && !p.HasSigned)
                            {
                                <div class="d-flex gap-2 align-items-center">
                                    <form asp-action="SignCks" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="partyId" value="@p.Id" />
                                        <button class="btn btn-sm btn-primary"><i class="bi bi-pen me-1"></i>Ký số (CKS)</button>
                                    </form>
                                    <form asp-action="OtpGenerate" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="partyId" value="@p.Id" />
                                        <button class="btn btn-sm btn-outline-primary" title="Gửi OTP"><i class="bi bi-shield-lock"></i> OTP</button>
                                    </form>
                                    <form asp-action="SignOtp" method="post" class="d-inline d-flex gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="partyId" value="@p.Id" />
                                        <input name="otp" class="form-control form-control-sm" style="width:90px" placeholder="mã OTP" />
                                        <button class="btn btn-sm btn-outline-success">Xác nhận</button>
                                    </form>
                                </div>
                            }
                        </div>
                        @if (!p.IsCancelled)
                        {
                            <form asp-action="UpdatePartyRemark" method="post" class="d-flex gap-2 mt-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="partyId" value="@p.Id" />
                                <input name="remark" class="form-control form-control-sm" value="@p.Remark" placeholder="Ghi chú cho bên này…" />
                                <button class="btn btn-sm btn-outline-secondary text-nowrap"><i class="bi bi-pencil-square me-1"></i>Lưu ghi chú</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>

        @if (!Model.IsAnnex)
        {
            <div class="card mt-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0">Phụ lục hợp đồng <span class="badge bg-secondary">@annexes.Count</span></h6>
                        <a href="/Contract/CreateAnnex/@Model.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Thêm phụ lục</a>
                    </div>
                    @if (annexes.Count == 0)
                    {
                        <div class="text-muted small">Chưa có phụ lục nào.</div>
                    }
                    else
                    {
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Số PL</th><th>Tiêu đề</th><th class="text-end">Giá trị</th><th>Ký</th><th>Trạng thái</th></tr></thead>
                            <tbody>
                            @foreach (var a in annexes)
                            {
                                var (ast, acss) = Ui.Status(a.Status);
                                <tr style="cursor:pointer" onclick="location.href='/Contract/Detail/@a.Id'">
                                    <td class="fw-semibold">@a.Code</td>
                                    <td>@a.Title</td>
                                    <td class="text-end">@a.Value.ToString("N0")</td>
                                    <td class="small">@a.SignedCount/@a.Parties.Count</td>
                                    <td><span class="badge bg-@acss">@ast</span></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-vector-pen me-1"></i>Ô ký trên hợp đồng <span class="badge bg-secondary">@elements.Count</span></h6>
                    <div class="small text-muted">
                        Đã ký <b>@elStats.Signed/@elStats.Total</b>
                        · <span class="badge bg-primary">Điện tử @elStats.Electronic</span>
                        <span class="badge bg-info">Ký tắt @elStats.Short</span>
                        <span class="badge bg-success">Ký số @elStats.Digital</span>
                    </div>
                </div>
                @if (elements.Count == 0)
                {
                    <div class="text-muted small">Chưa có ô ký nào.</div>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Tên ô</th><th>Loại</th><th>Bên</th><th>Trang / vị trí</th><th>Trạng thái</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var el in elements)
                        {
                            <tr>
                                <td class="fw-semibold">@el.ElementName<div class="text-muted" style="font-size:11px">@el.ElementCode</div></td>
                                <td><span class="badge bg-@(el.Type == ElementType.Digital ? "success" : el.Type == ElementType.Short ? "info" : "primary")">@el.TypeLabel</span></td>
                                <td class="small">@(el.Party?.Name ?? "—")</td>
                                <td class="small text-muted">tr.@el.PageIdx · (@el.ElementX.ToString("0"),@el.ElementY.ToString("0")) @el.ElementWidth.ToString("0")×@el.ElementHeight.ToString("0")</td>
                                <td>
                                    @if (el.IsSigned)
                                    {
                                        <span class="text-success small"><i class="bi bi-patch-check-fill me-1"></i>@el.SignerName · @el.SignedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                                        @if (el.SignFrom != null) { <div class="text-muted" style="font-size:11px">từ @el.SignFrom @(el.ElementIP != null ? "· " + el.ElementIP : "")</div> }
                                    }
                                    else { <span class="badge bg-warning text-dark">Chưa ký</span> }
                                </td>
                                <td class="text-end">
                                    @if (!el.IsSigned && canEditElements)
                                    {
                                        <form asp-action="SignElement" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="elementId" value="@el.Id" />
                                            <button class="btn btn-sm btn-outline-success"><i class="bi bi-pen me-1"></i>Ký ô</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                @if (canEditElements)
                {
                    <form asp-action="AddElement" method="post" class="row g-2 mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-4"><input name="elementName" class="form-control form-control-sm" placeholder="Tên ô ký (VD: Chữ ký Bên A)" required /></div>
                        <div class="col-md-2">
                            <select name="type" class="form-select form-select-sm">
                                <option value="0">Ký điện tử</option>
                                <option value="1">Ký tắt</option>
                                <option value="2">Ký số</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select name="partyId" class="form-select form-select-sm">
                                <option value="">— Bên sở hữu —</option>
                                @foreach (var p in Model.Parties.OrderBy(x => x.SignOrder))
                                {
                                    <option value="@p.Id">@Ui.Role(p.Role): @p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-1"><input name="pageIdx" type="number" value="1" min="1" class="form-control form-control-sm" title="Trang" /></div>
                        <div class="col-md-1"><input name="elementX" type="number" value="0" class="form-control form-control-sm" title="X" /></div>
                        <div class="col-md-1"><input name="elementY" type="number" value="0" class="form-control form-control-sm" title="Y" /></div>
                        <input type="hidden" name="elementWidth" value="120" />
                        <input type="hidden" name="elementHeight" value="40" />
                        <div class="col-12"><button class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Thêm ô ký</button></div>
                    </form>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-clipboard-check me-1"></i>Người kiểm tra hợp đồng <span class="badge bg-secondary">@checkers.Count</span></h6>
                    <div class="small text-muted">
                        @{ var (ckTxt, ckCss) = Ui.CheckStatus(ckStats.Status); }
                        <span class="badge bg-@ckCss">@ckTxt</span>
                        · Đã kiểm tra <b>@ckStats.Checked/@ckStats.Total</b>
                    </div>
                </div>
                @if (checkers.Count == 0)
                {
                    <div class="text-muted small">Chưa có người kiểm tra nào.</div>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>#</th><th>Người kiểm tra</th><th>Vai trò</th><th>Tuần tự</th><th>Trạng thái</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var ck in checkers)
                        {
                            <tr>
                                <td class="fw-semibold">@ck.Idx</td>
                                <td><b>@ck.UserName</b>@if (ck.Position != null) { <span class="text-muted small"> · @ck.Position</span> }<div class="text-muted" style="font-size:11px">@ck.UserCode</div></td>
                                <td><span class="badge bg-@(ck.IsChecker ? "primary" : "secondary")">@ck.RoleLabel</span></td>
                                <td class="small">@(ck.Sequential ? "Có" : "Không")</td>
                                <td>
                                    @if (ck.HasChecked)
                                    {
                                        <span class="text-success small"><i class="bi bi-patch-check-fill me-1"></i>Đã kiểm tra · @ck.CheckedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                                        @if (ck.Remark != null) { <div class="text-muted" style="font-size:11px">@ck.Remark</div> }
                                    }
                                    else { <span class="badge bg-warning text-dark">Chờ kiểm tra</span> }
                                </td>
                                <td class="text-end">
                                    @if (!ck.HasChecked && ck.IsChecker && canCheck)
                                    {
                                        <form asp-action="AcceptCheck" method="post" class="d-inline d-flex gap-1 justify-content-end">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="checkerId" value="@ck.Id" />
                                            <input name="remark" class="form-control form-control-sm" style="width:120px" placeholder="Ghi chú" />
                                            <button class="btn btn-sm btn-outline-success"><i class="bi bi-check2 me-1"></i>Kiểm tra</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                @if (canCheck)
                {
                    <form asp-action="AddChecker" method="post" class="row g-2 mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-4"><input name="userName" class="form-control form-control-sm" placeholder="Tên người kiểm tra" required /></div>
                        <div class="col-md-3"><input name="position" class="form-control form-control-sm" placeholder="Chức vụ (tùy chọn)" /></div>
                        <div class="col-md-1"><input name="idx" type="number" value="@(checkers.Count + 1)" min="1" class="form-control form-control-sm" title="Thứ tự" /></div>
                        <div class="col-md-2 d-flex align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="sequential" value="true" id="seqChk" checked />
                                <label class="form-check-label small" for="seqChk">Kiểm tra tuần tự</label>
                            </div>
                        </div>
                        <div class="col-12"><button class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Thêm người kiểm tra</button></div>
                    </form>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-patch-check me-1"></i>Phê duyệt hợp đồng</h6>
                    <div class="small text-muted">
                        @if (apStats.IsApproved)
                        {
                            <span class="badge bg-success">Đã phê duyệt</span>
                            <span class="ms-1">bởi <b>@apStats.ApprovedBy</b> · @apStats.ApprovedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Chưa phê duyệt</span>
                            <span class="ms-1">Đã duyệt <b>@apStats.Approved/@apStats.Checkers</b> người kiểm tra</span>
                        }
                    </div>
                </div>
                <div class="small text-muted mb-2">Chỉ người có vai trò <b>Người kiểm tra</b> mới được phê duyệt hợp đồng (người ký không có quyền duyệt).</div>
                @if (canApprove)
                {
                    <form asp-action="Approve" method="post" class="row g-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-4">
                            <select name="userCode" class="form-select form-select-sm" required>
                                <option value="">— Người phê duyệt —</option>
                                @foreach (var ck in checkers.Where(x => x.IsChecker))
                                {
                                    <option value="@ck.UserCode">@ck.UserName (@ck.UserCode)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-5"><input name="remark" class="form-control form-control-sm" placeholder="Ghi chú phê duyệt (tùy chọn)" /></div>
                        <div class="col-md-3"><button class="btn btn-sm btn-success w-100"><i class="bi bi-patch-check me-1"></i>Phê duyệt</button></div>
                    </form>
                }
                else if (apStats.IsApproved)
                {
                    <div class="alert alert-success small mb-0"><i class="bi bi-check-circle me-1"></i>Hợp đồng đã được phê duyệt lúc @apStats.ApprovedAt?.ToString("dd/MM/yyyy HH:mm") bởi <b>@apStats.ApprovedBy</b>.</div>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-people me-1"></i>Phân quyền hợp đồng <span class="badge bg-secondary">@userAssignments.Count</span></h6>
                    <div class="small text-muted">Người dùng được phép xử lý hợp đồng này</div>
                </div>
                @if (userAssignments.Count == 0)
                {
                    <div class="text-muted small">Chưa phân quyền cho người dùng nào.</div>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Người dùng</th><th>Email</th><th>Phân quyền lúc</th></tr></thead>
                        <tbody>
                        @foreach (var u in userAssignments)
                        {
                            <tr>
                                <td><b>@u.UserName</b><div class="text-muted" style="font-size:11px">@u.UserCode</div></td>
                                <td class="small">@(u.Email ?? "—")</td>
                                <td class="small text-muted">@u.AssignedAt.ToString("dd/MM/yyyy HH:mm") · @u.AssignedBy</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                @if (canAssign)
                {
                    <form asp-action="SaveUserAssignments" method="post" class="mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="small text-muted mb-2">Mỗi dòng 1 người dùng: <code>mã</code> | <code>tên</code> | <code>email</code> (cách nhau bằng dấu <b>|</b>). Lưu sẽ <b>ghi đè toàn bộ</b> danh sách phân quyền hiện tại.</div>
                        <textarea name="userCodes" class="form-control form-control-sm mb-2" rows="3" placeholder="vd: kt.le | Lê Thị Kiểm | kt.le@corp.vn"></textarea>
                        <button class="btn btn-sm btn-outline-primary"><i class="bi bi-save me-1"></i>Cập nhật phân quyền</button>
                    </form>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-person-badge me-1"></i>Người ký của hợp đồng <span class="badge bg-secondary">@signers.Count</span></h6>
                    <div class="small text-muted">
                        Đã ký <b>@sgStats.Confirmed/@sgStats.Total</b>
                        · Đã gửi <b>@sgStats.Sent</b>
                        · Chờ ký <b>@sgStats.Pending</b>
                    </div>
                </div>
                @if (signers.Count == 0)
                {
                    <div class="text-muted small">Chưa có người ký nào.</div>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>#</th><th>Người ký</th><th>Bên</th><th>Liên hệ</th><th>Gửi</th><th>Trạng thái ký</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var s in signers)
                        {
                            <tr>
                                <td class="fw-semibold">@s.Idx</td>
                                <td><b>@s.UserNameSign</b><div class="text-muted" style="font-size:11px">@s.UserCodeSysSign</div></td>
                                <td class="small">@(s.Party?.Name ?? "—")</td>
                                <td class="small text-muted">@(s.UserEmail ?? s.UserPhone ?? s.UserZalo ?? "—")</td>
                                <td>
                                    @if (s.FlagSendUser)
                                    {
                                        <span class="badge bg-info">Đã gửi</span>
                                        <div class="text-muted" style="font-size:11px">@s.SendDateUTC?.ToString("dd/MM/yyyy HH:mm") · @s.SendBy</div>
                                    }
                                    else { <span class="badge bg-secondary">Chưa gửi</span> }
                                </td>
                                <td>
                                    @if (s.IsConfirmed)
                                    {
                                        <span class="text-success small"><i class="bi bi-patch-check-fill me-1"></i>Đã ký · @s.ConfirmDTimeUTC?.ToString("dd/MM/yyyy HH:mm")</span>
                                        @if (s.ConfirmBy != null) { <div class="text-muted" style="font-size:11px">bởi @s.ConfirmBy</div> }
                                    }
                                    else { <span class="badge bg-warning text-dark">@s.SignStatusLabel</span> }
                                </td>
                                <td class="text-end">
                                    @if (canSigner && !s.FlagSendUser)
                                    {
                                        <form asp-action="MarkSignerSent" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="signerId" value="@s.Id" />
                                            <button class="btn btn-sm btn-outline-info"><i class="bi bi-send me-1"></i>Gửi</button>
                                        </form>
                                    }
                                    @if (canSigner && !s.IsConfirmed)
                                    {
                                        <form asp-action="ConfirmSigner" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="signerId" value="@s.Id" />
                                            <button class="btn btn-sm btn-outline-success"><i class="bi bi-pen me-1"></i>Xác nhận ký</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                @if (canSigner)
                {
                    <form asp-action="AddSigner" method="post" class="row g-2 mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-3"><input name="userNameSign" class="form-control form-control-sm" placeholder="Tên người ký" required /></div>
                        <div class="col-md-3">
                            <select name="partyId" class="form-select form-select-sm">
                                <option value="">— Bên của người ký —</option>
                                @foreach (var p in Model.Parties.OrderBy(x => x.SignOrder))
                                {
                                    <option value="@p.Id">@Ui.Role(p.Role): @p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3"><input name="userEmail" class="form-control form-control-sm" placeholder="Email (tùy chọn)" /></div>
                        <div class="col-md-1"><input name="idx" type="number" value="@(signers.Count + 1)" min="1" class="form-control form-control-sm" title="Thứ tự" /></div>
                        <div class="col-12"><button class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Thêm người ký</button></div>
                    </form>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-pen me-1"></i>Ký hợp đồng theo bên <span class="badge bg-secondary">@psStats.Confirmed/@psStats.Total</span></h6>
                    <div class="small text-muted">
                        @if (psStats.AllConfirmed)
                        {
                            <span class="badge bg-success">Đủ chữ ký các bên</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Còn @psStats.Pending bên chưa ký</span>
                        }
                    </div>
                </div>
                <div class="small text-muted mb-2">Mỗi bên ký hợp đồng (kèm xác thực OTP/token/phiên bản file). Khi <b>tất cả các bên</b> đã ký, hợp đồng tự chuyển sang <b>Hoàn tất</b>.</div>
                @if (Model.Parties.Count == 0)
                {
                    <div class="text-muted small">Hợp đồng chưa có bên tham gia.</div>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Bên</th><th>Người ký</th><th>Token</th><th>Trạng thái</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var p in Model.Parties.OrderBy(x => x.SignOrder))
                        {
                            <tr>
                                <td><span class="badge bg-secondary me-1">@Ui.Role(p.Role)</span><b>@p.Name</b></td>
                                <td class="small">@(p.UserNameSign ?? "—")<div class="text-muted" style="font-size:11px">@(p.UserCodeSign ?? "")</div></td>
                                <td class="small text-muted font-monospace">@(p.UserToken ?? "—")</td>
                                <td>
                                    @if (p.IsConfirmed)
                                    {
                                        <span class="text-success small"><i class="bi bi-patch-check-fill me-1"></i>Đã ký · @p.SignDateUTC?.ToString("dd/MM/yyyy HH:mm")</span>
                                        @if (p.SignBy != null) { <div class="text-muted" style="font-size:11px">bởi @p.SignBy</div> }
                                    }
                                    else if (p.IsCancelled) { <span class="badge bg-dark">Đã hủy</span> }
                                    else { <span class="badge bg-warning text-dark">Chờ ký</span> }
                                </td>
                                <td class="text-end">
                                    @if (canPartySign && !p.IsConfirmed && !p.IsCancelled)
                                    {
                                        <form asp-action="PartySign" method="post" class="d-flex gap-1 justify-content-end flex-wrap">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="partyId" value="@p.Id" />
                                            <input name="userNameSign" class="form-control form-control-sm" style="width:130px" value="@p.Name" placeholder="Tên người ký" />
                                            <input name="userToken" class="form-control form-control-sm" style="width:110px" value="@p.UserToken" placeholder="Token" />
                                            <input name="otpCode" class="form-control form-control-sm font-monospace" style="width:90px" placeholder="OTP" />
                                            <button class="btn btn-sm btn-primary"><i class="bi bi-pen me-1"></i>Ký</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-cash-coin me-1"></i>Cập nhật giá trị sau phê duyệt</h6>
                    <div class="small text-muted">Tỉ giá quy đổi: <b>@Model.CurrencyRate.ToString("N2")</b></div>
                </div>
                <div class="small text-muted mb-2">Sau khi hợp đồng đã gửi/đã phê duyệt, cập nhật <b>giá trị hợp đồng</b>, <b>đã thanh toán</b>, loại hợp đồng và ghi chú cho từng bên. Giá trị còn lại = giá trị hợp đồng − đã thanh toán.</div>
                @if (Model.Parties.Count == 0)
                {
                    <div class="text-muted small">Hợp đồng chưa có bên tham gia.</div>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Bên</th><th class="text-end">Giá trị HĐ</th><th class="text-end">Đã thanh toán</th><th class="text-end">Còn lại</th><th>Loại HĐ</th><th>Cập nhật</th></tr></thead>
                        <tbody>
                        @foreach (var p in Model.Parties.OrderBy(x => x.SignOrder))
                        {
                            <tr>
                                <td><span class="badge bg-secondary me-1">@Ui.Role(p.Role)</span><b>@p.Name</b></td>
                                <td class="text-end">@p.ValContract.ToString("N0")</td>
                                <td class="text-end">@p.ValPaymented.ToString("N0")</td>
                                <td class="text-end fw-semibold">@p.ValRemain.ToString("N0")</td>
                                <td class="small">@(p.ContractTypeName ?? p.ContractType ?? "—")</td>
                                <td class="small text-muted">@(p.ValueUpdatedAt != null ? $"{p.ValueUpdatedAt:dd/MM/yyyy HH:mm} · {p.ValueUpdatedBy}" : "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                @if (canUpdAfterApproved && Model.Parties.Count > 0)
                {
                    <form asp-action="UpdateAfterApproved" method="post" class="row g-2 mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-3">
                            <select name="partyId" class="form-select form-select-sm" required>
                                <option value="">— Bên cập nhật —</option>
                                @foreach (var p in Model.Parties.OrderBy(x => x.SignOrder))
                                {
                                    <option value="@p.Id">@Ui.Role(p.Role): @p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2"><input name="valContract" type="number" step="0.01" min="0" value="0" class="form-control form-control-sm" placeholder="Giá trị HĐ" required /></div>
                        <div class="col-md-2"><input name="valPaymented" type="number" step="0.01" min="0" value="0" class="form-control form-control-sm" placeholder="Đã thanh toán" required /></div>
                        <div class="col-md-2"><input name="contractTypeName" class="form-control form-control-sm" placeholder="Tên loại HĐ" /></div>
                        <div class="col-md-3"><input name="remark" class="form-control form-control-sm" placeholder="Ghi chú" /></div>
                        <input type="hidden" name="contractType" value="" />
                        <div class="col-12"><button class="btn btn-sm btn-outline-primary"><i class="bi bi-cash-coin me-1"></i>Cập nhật giá trị</button></div>
                    </form>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-send-check me-1"></i>Lịch sử gửi hợp đồng <span class="badge bg-secondary">@sendHistory.Count</span></h6>
                    <div class="small text-muted">Gửi cho các bên qua Email / SMS / Zalo</div>
                </div>
                @if (sendHistory.Count == 0)
                {
                    <div class="text-muted small">Chưa có lần gửi nào.</div>
                }
                else
                {
                    <form asp-action="Resend" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th style="width:30px"></th><th>Bên nhận</th><th>Kênh</th><th>Bản tin</th><th>Thông tin nhận</th><th>Thời gian</th></tr></thead>
                            <tbody>
                            @foreach (var sh in sendHistory)
                            {
                                <tr>
                                    <td>@if (canSend) { <input type="checkbox" name="sendHistIds" value="@sh.Id" class="form-check-input" /> }</td>
                                    <td><b>@sh.PartyName</b>@if (sh.Remark != null) { <div class="text-muted" style="font-size:11px">@sh.Remark</div> }</td>
                                    <td><span class="badge bg-@(sh.Channel == ChannelType.Email ? "primary" : sh.Channel == ChannelType.Sms ? "info" : "success")">@sh.ChannelLabel</span></td>
                                    <td><span class="badge bg-@(sh.Bulletin == BulletinType.Otp ? "warning text-dark" : "secondary")">@sh.BulletinLabel</span></td>
                                    <td class="small">@(sh.InfoReceive ?? "—")</td>
                                    <td class="small text-muted">@sh.SentAt.ToString("dd/MM/yyyy HH:mm") · @sh.SentBy</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        @if (canSend)
                        {
                            <button class="btn btn-sm btn-outline-primary mt-2"><i class="bi bi-arrow-repeat me-1"></i>Gửi lại các bản tin đã chọn</button>
                        }
                    </form>
                }

                @if (canSend)
                {
                    <form asp-action="AddSendHist" method="post" class="row g-2 mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-3">
                            <select name="partyId" class="form-select form-select-sm">
                                <option value="">— Bên nhận —</option>
                                @foreach (var p in Model.Parties.OrderBy(x => x.SignOrder))
                                {
                                    <option value="@p.Id">@Ui.Role(p.Role): @p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="channel" class="form-select form-select-sm">
                                <option value="0">Email</option>
                                <option value="1">SMS</option>
                                <option value="2">Zalo</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="bulletin" class="form-select form-select-sm">
                                <option value="0">Hợp đồng</option>
                                <option value="1">OTP</option>
                            </select>
                        </div>
                        <div class="col-md-3"><input name="infoReceive" class="form-control form-control-sm" placeholder="Email/SĐT/Zalo (tùy chọn)" /></div>
                        <div class="col-md-2"><input name="remark" class="form-control form-control-sm" placeholder="Ghi chú" /></div>
                        <div class="col-12"><button class="btn btn-sm btn-outline-primary"><i class="bi bi-send me-1"></i>Ghi nhận gửi</button></div>
                    </form>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-shield-lock me-1"></i>Mã OTP xác thực ký <span class="badge bg-secondary">@verifyOtps.Count</span></h6>
                    <div class="small text-muted">Sinh mã cho 1 bên, hạn mặc định 2 phút</div>
                </div>
                @if (verifyOtps.Count == 0)
                {
                    <div class="text-muted small">Chưa có mã OTP nào.</div>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Mã OTP</th><th>Người ký</th><th>Hiệu lực</th><th>Hết hạn</th><th>Trạng thái</th></tr></thead>
                        <tbody>
                        @foreach (var o in verifyOtps)
                        {
                            <tr>
                                <td class="fw-semibold font-monospace">@o.OtpCode</td>
                                <td class="small">@o.UserCodeSign</td>
                                <td class="small text-muted">@o.CreateDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td class="small text-muted">@o.EndDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>
                                    @if (o.UsedAt != null) { <span class="badge bg-success">Đã dùng</span> }
                                    else if (o.State == OtpState.Active) { <span class="badge bg-warning text-dark">Còn hiệu lực</span> }
                                    else { <span class="badge bg-secondary">@o.StateLabel</span> }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                @if (canOtp)
                {
                    <form asp-action="GenerateVerifyOtp" method="post" class="row g-2 mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-5">
                            <select name="partyId" class="form-select form-select-sm" required>
                                <option value="">— Bên cần sinh OTP —</option>
                                @foreach (var p in Model.Parties.Where(x => !x.HasSigned).OrderBy(x => x.SignOrder))
                                {
                                    <option value="@p.Id">@Ui.Role(p.Role): @p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2"><input name="validMinutes" type="number" value="2" min="1" class="form-control form-control-sm" title="Hạn (phút)" /></div>
                        <div class="col-md-3"><button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-shield-lock me-1"></i>Sinh mã OTP</button></div>
                    </form>
                    <form asp-action="VerifyOtp" method="post" class="row g-2 mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-4"><input name="otpCode" class="form-control form-control-sm font-monospace" placeholder="Nhập mã OTP" required /></div>
                        <div class="col-md-4"><input name="userCodeSign" class="form-control form-control-sm" placeholder="Người ký (email/tên, tùy chọn)" /></div>
                        <div class="col-md-4"><button class="btn btn-sm btn-outline-success w-100"><i class="bi bi-check2-circle me-1"></i>Xác thực OTP</button></div>
                    </form>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-file-earmark-pdf me-1"></i>File hợp đồng</h6>
                    @if (Model.HasFile)
                    {
                        <span class="badge bg-success">Đã có file</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Chưa có file</span>
                    }
                </div>
                @if (Model.HasFile)
                {
                    <table class="table table-sm align-middle mb-0">
                        <tbody>
                            <tr><th style="width:140px">Tên file</th><td class="fw-semibold">@Model.FileName</td></tr>
                            <tr><th>Đường dẫn</th><td class="small text-muted">@(Model.FilePath ?? "—")</td></tr>
                            <tr><th>Phiên bản</th><td class="small">@(Model.FileVersion ?? "—")</td></tr>
                            <tr><th>Cập nhật</th><td class="small text-muted">@Model.FileUpdatedAt?.ToString("dd/MM/yyyy HH:mm") · @Model.FileUpdatedBy</td></tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-muted small">Chưa cập nhật file bản thể hiện (PDF) cho hợp đồng này.</div>
                }
                <form asp-action="UpdateFile" method="post" class="row g-2 mt-3 pt-3 border-top">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="col-md-4"><input name="fileName" class="form-control form-control-sm" value="@Model.FileName" placeholder="Tên file (VD: HopDong-@(Model.Code).pdf)" required /></div>
                    <div class="col-md-4"><input name="filePath" class="form-control form-control-sm" value="@Model.FilePath" placeholder="Đường dẫn file đã ký (tùy chọn)" /></div>
                    <div class="col-md-2"><input name="fileVersion" class="form-control form-control-sm" value="@Model.FileVersion" placeholder="Phiên bản" /></div>
                    <div class="col-md-2"><button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-save me-1"></i>Lưu file</button></div>
                </form>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-list-ul me-1"></i>Chi tiết hợp đồng (hàng hóa/dịch vụ) <span class="badge bg-secondary">@dtStats.Lines</span></h6>
                    <span class="small text-muted">Tổng thanh toán: <b class="text-success">@dtStats.GrandTotal.ToString("N0") đ</b></span>
                </div>
                @if (details.Count == 0)
                {
                    <div class="text-muted small">Chưa có dòng chi tiết nào.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:36px">#</th>
                                    <th>Hàng hóa/dịch vụ</th>
                                    <th class="text-end">SL</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                    <th class="text-end">Thuế</th>
                                    <th class="text-end">Chiết khấu</th>
                                    <th class="text-end">Tổng dòng</th>
                                    @if (canEditDetails) { <th style="width:44px"></th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in details)
                                {
                                    <tr>
                                        <td class="text-muted">@d.Idx</td>
                                        <td>
                                            <div class="fw-semibold">@d.SpecName</div>
                                            <div class="text-muted" style="font-size:11px">@d.SpecCode · ĐVT: @d.UnitLabel@(d.VATRate > 0 ? $" · VAT {d.VATRate:N0}%" : "")@(d.Remark != null ? " · " + d.Remark : "")</div>
                                        </td>
                                        <td class="text-end">@d.Qty.ToString("N0")</td>
                                        <td class="text-end">@d.UnitPrice.ToString("N0")</td>
                                        <td class="text-end">@d.ValContract.ToString("N0")</td>
                                        <td class="text-end">@d.ValTax.ToString("N0")</td>
                                        <td class="text-end">@d.ValDiscount.ToString("N0")</td>
                                        <td class="text-end fw-semibold">@d.LineTotal.ToString("N0")</td>
                                        @if (canEditDetails)
                                        {
                                            <td>
                                                <form asp-action="DeleteDetail" method="post" onsubmit="return confirm('Xóa dòng chi tiết này?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@Model.Id" />
                                                    <input type="hidden" name="detailId" value="@d.Id" />
                                                    <button class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                                                </form>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-light">
                                    <td colspan="4" class="text-end fw-semibold">Tổng cộng</td>
                                    <td class="text-end fw-semibold">@dtStats.Total.ToString("N0")</td>
                                    <td class="text-end fw-semibold">@dtStats.Tax.ToString("N0")</td>
                                    <td class="text-end fw-semibold">@dtStats.Discount.ToString("N0")</td>
                                    <td class="text-end fw-bold text-success">@dtStats.GrandTotal.ToString("N0")</td>
                                    @if (canEditDetails) { <td></td> }
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }

                @if (canEditDetails)
                {
                    <form asp-action="AddDetail" method="post" class="row g-2 mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-4"><input name="specName" class="form-control form-control-sm" placeholder="Tên hàng hóa/dịch vụ" required /></div>
                        <div class="col-md-2"><input name="specCode" class="form-control form-control-sm" placeholder="Mã (tùy chọn)" /></div>
                        <div class="col-md-2"><input name="unitName" class="form-control form-control-sm" placeholder="ĐVT" /></div>
                        <div class="col-md-2"><input name="qty" type="number" step="any" min="0" value="1" class="form-control form-control-sm" placeholder="Số lượng" /></div>
                        <div class="col-md-2"><input name="unitPrice" type="number" step="any" min="0" value="0" class="form-control form-control-sm" placeholder="Đơn giá" /></div>
                        <div class="col-md-2"><input name="vatRate" type="number" step="any" min="0" value="0" class="form-control form-control-sm" placeholder="VAT %" /></div>
                        <div class="col-md-2"><input name="discountRate" type="number" step="any" min="0" value="0" class="form-control form-control-sm" placeholder="Chiết khấu %" /></div>
                        <div class="col-md-4"><input name="remark" class="form-control form-control-sm" placeholder="Ghi chú (tùy chọn)" /></div>
                        <div class="col-md-4"><button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-plus-square me-1"></i>Thêm dòng chi tiết</button></div>
                    </form>
                    <p class="text-muted small mt-2 mb-0">Thành tiền = SL × Đơn giá; Thuế = (Thành tiền − Chiết khấu) × VAT%; Chiết khấu = Thành tiền × CK% — port từ <code>Contract_ContractDtl</code> (QContract).</p>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-input-cursor-text me-1"></i>Trường động hợp đồng <span class="badge bg-secondary">@attributes.Count</span></h6>
                    <a href="/Contract/AttributeMasters" class="small">Quản lý danh mục trường động</a>
                </div>
                @if (attributes.Count == 0)
                {
                    <div class="text-muted small">Chưa có trường động nào.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr><th>Mã trường</th><th>Tên trường</th><th>Giá trị</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var a in attributes)
                                {
                                    <tr>
                                        <td><code>@a.AttributeContractCode</code></td>
                                        <td>@a.AttributeName</td>
                                        <td class="fw-semibold">@a.AttributeValue</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (canEditAttributes)
                {
                    <form asp-action="SaveAttributes" method="post" class="mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label class="small text-muted">Mỗi dòng: <code>mã trường | giá trị</code> (mã phải có trong danh mục trường động đang hiệu lực)</label>
                        <textarea name="attributes" rows="3" class="form-control form-control-sm" placeholder="LOAI_HD | Mua bán">@string.Join("\n", attributes.Select(a => $"{a.AttributeContractCode} | {a.AttributeValue}"))</textarea>
                        <button class="btn btn-sm btn-outline-primary mt-2"><i class="bi bi-save me-1"></i>Lưu trường động (ghi đè)</button>
                    </form>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-input-cursor me-1"></i>Trường động chi tiết <span class="badge bg-secondary">@attributeDetails.Count</span></h6>
                </div>
                @if (attributeDetails.Count == 0)
                {
                    <div class="text-muted small">Chưa có trường động chi tiết nào.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr><th style="width:60px">Dòng</th><th>Mã trường</th><th>Tên trường</th><th>Giá trị</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var a in attributeDetails)
                                {
                                    <tr>
                                        <td class="text-muted">@a.Idx</td>
                                        <td><code>@a.AttributeContractCode</code></td>
                                        <td>@a.AttributeName</td>
                                        <td class="fw-semibold">@a.AttributeValue</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (canEditAttributes)
                {
                    <form asp-action="SaveAttributeDetails" method="post" class="mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label class="small text-muted">Mỗi dòng: <code>thứ tự | mã trường | giá trị</code></label>
                        <textarea name="attributes" rows="3" class="form-control form-control-sm" placeholder="1 | XUAT_XU | Việt Nam">@string.Join("\n", attributeDetails.Select(a => $"{a.Idx} | {a.AttributeContractCode} | {a.AttributeValue}"))</textarea>
                        <button class="btn btn-sm btn-outline-primary mt-2"><i class="bi bi-save me-1"></i>Lưu trường động chi tiết (ghi đè)</button>
                    </form>
                }
                <p class="text-muted small mt-2 mb-0">Trường động (thuộc tính động) cấp hợp đồng/chi tiết — port từ <code>Contract_Attribute_Contract</code> + <code>Contract_Attribute_ContractDtl</code> (QContract). Lưu là ghi đè toàn bộ.</p>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-people me-1"></i>Thông tin bên tham gia <span class="badge bg-secondary">@Model.Parties.Count</span></h6>
                    <span class="small text-muted">Đã có thông tin: <b>@partyInfoStats.WithInfo</b> · Đã gửi mail: <b>@partyInfoStats.EmailSent</b></span>
                </div>
                @if (Model.Parties.Count == 0)
                {
                    <div class="text-muted small">Hợp đồng chưa có bên tham gia.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr><th>Bên</th><th>MST</th><th>Liên hệ</th><th>Ngân hàng</th><th>Người đại diện</th><th>Mail thông báo</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Parties.OrderBy(x => x.SignOrder))
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@p.Name</div>
                                            <span class="badge bg-light text-dark">@Ui.Role(p.Role)</span>
                                            @if (p.HasInfo) { <span class="badge bg-info text-dark">Có thông tin</span> }
                                        </td>
                                        <td class="small">@(p.TaxCode ?? "—")</td>
                                        <td class="small">
                                            @(p.Email ?? "—")<br />
                                            <span class="text-muted">@(p.Phone ?? "—")@(p.Address != null ? " · " + p.Address : "")</span>
                                        </td>
                                        <td class="small">@(p.BankName ?? "—")@(p.BankAccountNo != null ? " · " + p.BankAccountNo : "")</td>
                                        <td class="small">@(p.RepresentName ?? "—")@(p.RepresentPosition != null ? " (" + p.RepresentPosition + ")" : "")</td>
                                        <td class="small">
                                            @if (p.EmailSent)
                                            {
                                                <span class="badge bg-success">Đã gửi</span>
                                                <div class="text-muted" style="font-size:11px">@p.EmailSend · @p.SendEmailDTimeUTC?.ToString("dd/MM/yyyy HH:mm")</div>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Chưa gửi</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (canEditParty)
                {
                    <form asp-action="UpdateParty" method="post" class="row g-2 mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-4">
                            <select name="partyId" class="form-select form-select-sm" required>
                                <option value="">— Bên cần cập nhật —</option>
                                @foreach (var p in Model.Parties.OrderBy(x => x.SignOrder))
                                {
                                    <option value="@p.Id">@Ui.Role(p.Role): @p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4"><input name="name" class="form-control form-control-sm" placeholder="Tên bên" required /></div>
                        <div class="col-md-4"><input name="taxCode" class="form-control form-control-sm" placeholder="Mã số thuế (MST)" /></div>
                        <div class="col-md-4"><input name="email" class="form-control form-control-sm" placeholder="Email" /></div>
                        <div class="col-md-4"><input name="phone" class="form-control form-control-sm" placeholder="Số điện thoại" /></div>
                        <div class="col-md-4"><input name="website" class="form-control form-control-sm" placeholder="Website" /></div>
                        <div class="col-md-6"><input name="address" class="form-control form-control-sm" placeholder="Địa chỉ" /></div>
                        <div class="col-md-3"><input name="bankName" class="form-control form-control-sm" placeholder="Tên ngân hàng" /></div>
                        <div class="col-md-3"><input name="bankAccountNo" class="form-control form-control-sm" placeholder="Số tài khoản" /></div>
                        <div class="col-md-4"><input name="representName" class="form-control form-control-sm" placeholder="Người đại diện" /></div>
                        <div class="col-md-4"><input name="representPosition" class="form-control form-control-sm" placeholder="Chức vụ người đại diện" /></div>
                        <input type="hidden" name="bankCode" value="" />
                        <div class="col-md-4"><button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-save me-1"></i>Cập nhật thông tin bên</button></div>
                    </form>

                    <form asp-action="MarkPartyEmailSent" method="post" class="row g-2 mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-5">
                            <select name="partyId" class="form-select form-select-sm" required>
                                <option value="">— Bên nhận mail —</option>
                                @foreach (var p in Model.Parties.OrderBy(x => x.SignOrder))
                                {
                                    <option value="@p.Id">@Ui.Role(p.Role): @p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4"><input name="emailSend" class="form-control form-control-sm" placeholder="Email gửi (mặc định lấy email bên)" /></div>
                        <div class="col-md-3"><button class="btn btn-sm btn-outline-success w-100"><i class="bi bi-envelope-check me-1"></i>Ghi nhận gửi mail</button></div>
                    </form>
                    <p class="text-muted small mt-2 mb-0">Cập nhật thông tin pháp lý/liên hệ của bên + ghi nhận gửi mail thông báo — port từ <code>Contract_ContractParty_Update</code> + <code>Contract_ContractParty_UpdEmailSend</code> (QContract).</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Thao tác</h6>
                <div class="mb-2 small text-muted">Tiến độ ký: <b>@Model.SignedCount/@Model.Parties.Count</b></div>
                <div class="progress mb-3" style="height:8px">
                    <div class="progress-bar bg-success" style="width:@(Model.Parties.Count == 0 ? 0 : Model.SignedCount * 100 / Model.Parties.Count)%"></div>
                </div>

                @if (Model.Status == ContractStatus.Draft)
                {
                    <form asp-action="Send" method="post" class="mb-2">
                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-primary w-100"><i class="bi bi-send me-1"></i>Gửi các bên ký</button>
                    </form>
                }
                <a href="/Contract/Pdf/@Model.Id" class="btn btn-outline-primary w-100 mb-2" target="_blank"><i class="bi bi-file-pdf me-1"></i>Tải bản thể hiện (PDF)</a>
                @if (!Model.IsAnnex)
                {
                    <a href="/Contract/CreateAnnex/@Model.Id" class="btn btn-outline-info w-100 mb-2"><i class="bi bi-file-earmark-plus me-1"></i>Tạo phụ lục</a>
                }
                @if (Model.Status != ContractStatus.Completed && Model.Status != ContractStatus.Cancelled && Model.Status != ContractStatus.Finished)
                {
                    <form asp-action="Cancel" method="post" onsubmit="return confirm('Hủy hợp đồng này?')">
                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-outline-danger w-100"><i class="bi bi-x-circle me-1"></i>Hủy hợp đồng</button>
                    </form>
                }
                @if (Model.Status != ContractStatus.Cancelled && Model.Status != ContractStatus.Finished)
                {
                    <a href="/Contract/Finish/@Model.Id" class="btn btn-outline-secondary w-100 mt-2"><i class="bi bi-flag me-1"></i>Kết thúc hợp đồng</a>
                }
                @if (canCancelByParty)
                {
                    <div class="mt-3 pt-3 border-top">
                        <div class="small text-muted mb-2"><i class="bi bi-person-x me-1"></i>Hủy bởi một bên — bên hủy sẽ chuyển trạng thái <b>Đã hủy</b> và hợp đồng bị hủy.</div>
                        <form asp-action="CancelByParty" method="post" onsubmit="return confirm('Bên này hủy hợp đồng? Hợp đồng sẽ bị hủy.')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <select name="partyId" class="form-select form-select-sm mb-2" required>
                                <option value="">— Bên hủy hợp đồng —</option>
                                @foreach (var p in Model.Parties.Where(x => !x.IsCancelled).OrderBy(x => x.SignOrder))
                                {
                                    <option value="@p.Id">@Ui.Role(p.Role): @p.Name</option>
                                }
                            </select>
                            <input name="remark" class="form-control form-control-sm mb-2" placeholder="Lý do hủy (tùy chọn)" />
                            <button class="btn btn-outline-danger w-100"><i class="bi bi-person-x me-1"></i>Hủy bởi bên đã chọn</button>
                        </form>
                    </div>
                }
                @if (Model.Status == ContractStatus.Completed)
                {
                    <div class="alert alert-success small mb-0"><i class="bi bi-check-circle me-1"></i>Hoàn tất lúc @Model.CompletedAt?.ToString("dd/MM/yyyy HH:mm") — đủ chữ ký các bên.</div>
                }
                @if (Model.IsFinished)
                {
                    <div class="alert alert-secondary small mb-0"><i class="bi bi-flag me-1"></i>Đã kết thúc lúc @Model.FinishedAt?.ToString("dd/MM/yyyy HH:mm") — lý do: <b>@Model.FinishReasonName</b>.</div>
                }
            </div>
        </div>
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-clock-history me-1"></i>Nhật ký thao tác <span class="badge bg-secondary">@history.Count</span></h6>
            @if (history.Count == 0)
            {
                <div class="text-muted small">Chưa có thao tác nào.</div>
            }
            else
            {
                <ul class="list-unstyled small mb-0">
                    @foreach (var h in history)
                    {
                        var (ht, hcss, hicon) = Ui.Action(h.Action);
                        <li class="mb-2 d-flex gap-2">
                            <i class="bi @hicon text-@hcss" style="font-size:12px"></i>
                            <div>
                                <span class="badge bg-@hcss">@ht</span>
                                <span class="ms-1">@h.Description</span>
                                <div class="text-muted" style="font-size:11px">@h.Actor · @h.At.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </li>
                    }
                </ul>
            }
            <form asp-action="AddRemark" method="post" class="mt-3 d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input name="remark" class="form-control form-control-sm" placeholder="Ghi chú xử lý…" />
                <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-chat-left-text"></i></button>
            </form>
        </div></div>
    </div>
</div>
