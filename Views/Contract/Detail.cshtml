@model Contract
@{
    ViewData["Title"] = $"Hợp đồng {Model.Code}";
    var (st, css) = Ui.Status(Model.Status);
    bool canSign = Model.Status is ContractStatus.Sent or ContractStatus.PartiallySigned;
    var annexes = (List<Contract>)(ViewBag.Annexes ?? new List<Contract>());
    var history = (List<ContractHistory>)(ViewBag.History ?? new List<ContractHistory>());
    var elements = (List<ContractElement>)(ViewBag.Elements ?? new List<ContractElement>());
    var elStats = (ElementStats)(ViewBag.ElementStats ?? new ElementStats(0, 0, 0, 0, 0));
    var checkers = (List<ContractChecker>)(ViewBag.Checkers ?? new List<ContractChecker>());
    var ckStats = (CheckerStats)(ViewBag.CheckerStats ?? new CheckerStats(0, 0, 0, CheckerStatus.None));
    var apStats = (ApproveStats)(ViewBag.ApproveStats ?? new ApproveStats(0, 0, false, null, null));
    var userAssignments = (List<ContractUserInContract>)(ViewBag.UserAssignments ?? new List<ContractUserInContract>());
    var sendHistory = (List<ContractSendHist>)(ViewBag.SendHistory ?? new List<ContractSendHist>());
    bool canEditElements = Model.Status is not (ContractStatus.Completed or ContractStatus.Cancelled);
    bool canCheck = Model.Status is not (ContractStatus.Completed or ContractStatus.Cancelled);
    bool canApprove = Model.Status is not (ContractStatus.Completed or ContractStatus.Cancelled or ContractStatus.Finished) && !Model.IsApproved;
    bool canAssign = Model.Status is not (ContractStatus.Cancelled or ContractStatus.Finished);
    bool canSend = Model.Status is not (ContractStatus.Cancelled or ContractStatus.Finished);
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h5 class="fw-bold mb-1">@Model.Title</h5>
                        <div class="text-muted small">Số @Model.Code · @(Model.Type?.Name ?? "—") · tạo @Model.CreatedAt.ToString("dd/MM/yyyy")</div>
                        @if (Model.IsAnnex)
                        {
                            <div class="mt-1"><span class="badge bg-info">Phụ lục</span> <span class="small text-muted">của hợp đồng gốc</span> <a href="/Contract/Detail/@Model.ParentContractId" class="small fw-semibold">@Model.ParentContractCode</a></div>
                        }
                        @if (Model.IsFinished)
                        {
                            <div class="mt-1"><span class="badge bg-secondary">Đã kết thúc</span> <span class="small text-muted">lý do:</span> <b class="small">@Model.FinishReasonName</b> <span class="small text-muted">· @Model.FinishedAt?.ToString("dd/MM/yyyy HH:mm")</span></div>
                            @if (Model.FinishDescription != null) { <div class="small text-muted">@Model.FinishDescription</div> }
                        }
                    </div>
                    <span class="badge bg-@css fs-6">@st</span>
                </div>
                <div class="mb-2"><span class="text-muted small">Giá trị:</span> <b>@Model.Value.ToString("N0") đ</b></div>
                <div class="p-3 rounded" style="background:#f6faf9;white-space:pre-wrap">@Model.Body</div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Các bên & chữ ký</h6>
                @foreach (var p in Model.Parties.OrderBy(x => x.SignOrder))
                {
                    var sig = Model.Signatures.FirstOrDefault(s => s.PartyId == p.Id);
                    <div class="border rounded p-3 mb-2">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <span class="badge bg-secondary me-1">@Ui.Role(p.Role)</span>
                                <b>@p.Name</b> @if (p.Email != null) { <span class="text-muted small">· @p.Email</span> }
                                @if (p.HasSigned)
                                {
                                    <div class="text-success small mt-1"><i class="bi bi-patch-check-fill me-1"></i>Đã ký @(sig != null ? "bằng " + Ui.Method(sig.Method) : "") lúc @p.SignedAt?.ToString("dd/MM/yyyy HH:mm")
                                        @if (sig?.CertSubject != null) { <div class="text-muted" style="font-size:11px">CTS: @sig.CertSubject</div> }
                                        @if (sig?.SignatureValue != null) { <div class="text-muted text-truncate" style="font-size:10px;max-width:420px" title="@sig.SignatureValue">Chữ ký: @sig.SignatureValue</div> }
                                    </div>
                                }
                                else { <span class="text-muted small ms-1">· chưa ký</span> }
                            </div>
                            @if (canSign && !p.HasSigned)
                            {
                                <div class="d-flex gap-2 align-items-center">
                                    <form asp-action="SignCks" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="partyId" value="@p.Id" />
                                        <button class="btn btn-sm btn-primary"><i class="bi bi-pen me-1"></i>Ký số (CKS)</button>
                                    </form>
                                    <form asp-action="OtpGenerate" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="partyId" value="@p.Id" />
                                        <button class="btn btn-sm btn-outline-primary" title="Gửi OTP"><i class="bi bi-shield-lock"></i> OTP</button>
                                    </form>
                                    <form asp-action="SignOtp" method="post" class="d-inline d-flex gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="partyId" value="@p.Id" />
                                        <input name="otp" class="form-control form-control-sm" style="width:90px" placeholder="mã OTP" />
                                        <button class="btn btn-sm btn-outline-success">Xác nhận</button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (!Model.IsAnnex)
        {
            <div class="card mt-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0">Phụ lục hợp đồng <span class="badge bg-secondary">@annexes.Count</span></h6>
                        <a href="/Contract/CreateAnnex/@Model.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Thêm phụ lục</a>
                    </div>
                    @if (annexes.Count == 0)
                    {
                        <div class="text-muted small">Chưa có phụ lục nào.</div>
                    }
                    else
                    {
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Số PL</th><th>Tiêu đề</th><th class="text-end">Giá trị</th><th>Ký</th><th>Trạng thái</th></tr></thead>
                            <tbody>
                            @foreach (var a in annexes)
                            {
                                var (ast, acss) = Ui.Status(a.Status);
                                <tr style="cursor:pointer" onclick="location.href='/Contract/Detail/@a.Id'">
                                    <td class="fw-semibold">@a.Code</td>
                                    <td>@a.Title</td>
                                    <td class="text-end">@a.Value.ToString("N0")</td>
                                    <td class="small">@a.SignedCount/@a.Parties.Count</td>
                                    <td><span class="badge bg-@acss">@ast</span></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-vector-pen me-1"></i>Ô ký trên hợp đồng <span class="badge bg-secondary">@elements.Count</span></h6>
                    <div class="small text-muted">
                        Đã ký <b>@elStats.Signed/@elStats.Total</b>
                        · <span class="badge bg-primary">Điện tử @elStats.Electronic</span>
                        <span class="badge bg-info">Ký tắt @elStats.Short</span>
                        <span class="badge bg-success">Ký số @elStats.Digital</span>
                    </div>
                </div>
                @if (elements.Count == 0)
                {
                    <div class="text-muted small">Chưa có ô ký nào.</div>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Tên ô</th><th>Loại</th><th>Bên</th><th>Trang / vị trí</th><th>Trạng thái</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var el in elements)
                        {
                            <tr>
                                <td class="fw-semibold">@el.ElementName<div class="text-muted" style="font-size:11px">@el.ElementCode</div></td>
                                <td><span class="badge bg-@(el.Type == ElementType.Digital ? "success" : el.Type == ElementType.Short ? "info" : "primary")">@el.TypeLabel</span></td>
                                <td class="small">@(el.Party?.Name ?? "—")</td>
                                <td class="small text-muted">tr.@el.PageIdx · (@el.ElementX.ToString("0"),@el.ElementY.ToString("0")) @el.ElementWidth.ToString("0")×@el.ElementHeight.ToString("0")</td>
                                <td>
                                    @if (el.IsSigned)
                                    {
                                        <span class="text-success small"><i class="bi bi-patch-check-fill me-1"></i>@el.SignerName · @el.SignedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                                        @if (el.SignFrom != null) { <div class="text-muted" style="font-size:11px">từ @el.SignFrom @(el.ElementIP != null ? "· " + el.ElementIP : "")</div> }
                                    }
                                    else { <span class="badge bg-warning text-dark">Chưa ký</span> }
                                </td>
                                <td class="text-end">
                                    @if (!el.IsSigned && canEditElements)
                                    {
                                        <form asp-action="SignElement" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="elementId" value="@el.Id" />
                                            <button class="btn btn-sm btn-outline-success"><i class="bi bi-pen me-1"></i>Ký ô</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                @if (canEditElements)
                {
                    <form asp-action="AddElement" method="post" class="row g-2 mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-4"><input name="elementName" class="form-control form-control-sm" placeholder="Tên ô ký (VD: Chữ ký Bên A)" required /></div>
                        <div class="col-md-2">
                            <select name="type" class="form-select form-select-sm">
                                <option value="0">Ký điện tử</option>
                                <option value="1">Ký tắt</option>
                                <option value="2">Ký số</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select name="partyId" class="form-select form-select-sm">
                                <option value="">— Bên sở hữu —</option>
                                @foreach (var p in Model.Parties.OrderBy(x => x.SignOrder))
                                {
                                    <option value="@p.Id">@Ui.Role(p.Role): @p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-1"><input name="pageIdx" type="number" value="1" min="1" class="form-control form-control-sm" title="Trang" /></div>
                        <div class="col-md-1"><input name="elementX" type="number" value="0" class="form-control form-control-sm" title="X" /></div>
                        <div class="col-md-1"><input name="elementY" type="number" value="0" class="form-control form-control-sm" title="Y" /></div>
                        <input type="hidden" name="elementWidth" value="120" />
                        <input type="hidden" name="elementHeight" value="40" />
                        <div class="col-12"><button class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Thêm ô ký</button></div>
                    </form>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-clipboard-check me-1"></i>Người kiểm tra hợp đồng <span class="badge bg-secondary">@checkers.Count</span></h6>
                    <div class="small text-muted">
                        @{ var (ckTxt, ckCss) = Ui.CheckStatus(ckStats.Status); }
                        <span class="badge bg-@ckCss">@ckTxt</span>
                        · Đã kiểm tra <b>@ckStats.Checked/@ckStats.Total</b>
                    </div>
                </div>
                @if (checkers.Count == 0)
                {
                    <div class="text-muted small">Chưa có người kiểm tra nào.</div>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>#</th><th>Người kiểm tra</th><th>Vai trò</th><th>Tuần tự</th><th>Trạng thái</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var ck in checkers)
                        {
                            <tr>
                                <td class="fw-semibold">@ck.Idx</td>
                                <td><b>@ck.UserName</b>@if (ck.Position != null) { <span class="text-muted small"> · @ck.Position</span> }<div class="text-muted" style="font-size:11px">@ck.UserCode</div></td>
                                <td><span class="badge bg-@(ck.IsChecker ? "primary" : "secondary")">@ck.RoleLabel</span></td>
                                <td class="small">@(ck.Sequential ? "Có" : "Không")</td>
                                <td>
                                    @if (ck.HasChecked)
                                    {
                                        <span class="text-success small"><i class="bi bi-patch-check-fill me-1"></i>Đã kiểm tra · @ck.CheckedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                                        @if (ck.Remark != null) { <div class="text-muted" style="font-size:11px">@ck.Remark</div> }
                                    }
                                    else { <span class="badge bg-warning text-dark">Chờ kiểm tra</span> }
                                </td>
                                <td class="text-end">
                                    @if (!ck.HasChecked && ck.IsChecker && canCheck)
                                    {
                                        <form asp-action="AcceptCheck" method="post" class="d-inline d-flex gap-1 justify-content-end">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="checkerId" value="@ck.Id" />
                                            <input name="remark" class="form-control form-control-sm" style="width:120px" placeholder="Ghi chú" />
                                            <button class="btn btn-sm btn-outline-success"><i class="bi bi-check2 me-1"></i>Kiểm tra</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                @if (canCheck)
                {
                    <form asp-action="AddChecker" method="post" class="row g-2 mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-4"><input name="userName" class="form-control form-control-sm" placeholder="Tên người kiểm tra" required /></div>
                        <div class="col-md-3"><input name="position" class="form-control form-control-sm" placeholder="Chức vụ (tùy chọn)" /></div>
                        <div class="col-md-1"><input name="idx" type="number" value="@(checkers.Count + 1)" min="1" class="form-control form-control-sm" title="Thứ tự" /></div>
                        <div class="col-md-2 d-flex align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="sequential" value="true" id="seqChk" checked />
                                <label class="form-check-label small" for="seqChk">Kiểm tra tuần tự</label>
                            </div>
                        </div>
                        <div class="col-12"><button class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Thêm người kiểm tra</button></div>
                    </form>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-patch-check me-1"></i>Phê duyệt hợp đồng</h6>
                    <div class="small text-muted">
                        @if (apStats.IsApproved)
                        {
                            <span class="badge bg-success">Đã phê duyệt</span>
                            <span class="ms-1">bởi <b>@apStats.ApprovedBy</b> · @apStats.ApprovedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Chưa phê duyệt</span>
                            <span class="ms-1">Đã duyệt <b>@apStats.Approved/@apStats.Checkers</b> người kiểm tra</span>
                        }
                    </div>
                </div>
                <div class="small text-muted mb-2">Chỉ người có vai trò <b>Người kiểm tra</b> mới được phê duyệt hợp đồng (người ký không có quyền duyệt).</div>
                @if (canApprove)
                {
                    <form asp-action="Approve" method="post" class="row g-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-4">
                            <select name="userCode" class="form-select form-select-sm" required>
                                <option value="">— Người phê duyệt —</option>
                                @foreach (var ck in checkers.Where(x => x.IsChecker))
                                {
                                    <option value="@ck.UserCode">@ck.UserName (@ck.UserCode)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-5"><input name="remark" class="form-control form-control-sm" placeholder="Ghi chú phê duyệt (tùy chọn)" /></div>
                        <div class="col-md-3"><button class="btn btn-sm btn-success w-100"><i class="bi bi-patch-check me-1"></i>Phê duyệt</button></div>
                    </form>
                }
                else if (apStats.IsApproved)
                {
                    <div class="alert alert-success small mb-0"><i class="bi bi-check-circle me-1"></i>Hợp đồng đã được phê duyệt lúc @apStats.ApprovedAt?.ToString("dd/MM/yyyy HH:mm") bởi <b>@apStats.ApprovedBy</b>.</div>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-people me-1"></i>Phân quyền hợp đồng <span class="badge bg-secondary">@userAssignments.Count</span></h6>
                    <div class="small text-muted">Người dùng được phép xử lý hợp đồng này</div>
                </div>
                @if (userAssignments.Count == 0)
                {
                    <div class="text-muted small">Chưa phân quyền cho người dùng nào.</div>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Người dùng</th><th>Email</th><th>Phân quyền lúc</th></tr></thead>
                        <tbody>
                        @foreach (var u in userAssignments)
                        {
                            <tr>
                                <td><b>@u.UserName</b><div class="text-muted" style="font-size:11px">@u.UserCode</div></td>
                                <td class="small">@(u.Email ?? "—")</td>
                                <td class="small text-muted">@u.AssignedAt.ToString("dd/MM/yyyy HH:mm") · @u.AssignedBy</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                @if (canAssign)
                {
                    <form asp-action="SaveUserAssignments" method="post" class="mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="small text-muted mb-2">Mỗi dòng 1 người dùng: <code>mã</code> | <code>tên</code> | <code>email</code> (cách nhau bằng dấu <b>|</b>). Lưu sẽ <b>ghi đè toàn bộ</b> danh sách phân quyền hiện tại.</div>
                        <textarea name="userCodes" class="form-control form-control-sm mb-2" rows="3" placeholder="vd: kt.le | Lê Thị Kiểm | kt.le@corp.vn"></textarea>
                        <button class="btn btn-sm btn-outline-primary"><i class="bi bi-save me-1"></i>Cập nhật phân quyền</button>
                    </form>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-send-check me-1"></i>Lịch sử gửi hợp đồng <span class="badge bg-secondary">@sendHistory.Count</span></h6>
                    <div class="small text-muted">Gửi cho các bên qua Email / SMS / Zalo</div>
                </div>
                @if (sendHistory.Count == 0)
                {
                    <div class="text-muted small">Chưa có lần gửi nào.</div>
                }
                else
                {
                    <form asp-action="Resend" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th style="width:30px"></th><th>Bên nhận</th><th>Kênh</th><th>Bản tin</th><th>Thông tin nhận</th><th>Thời gian</th></tr></thead>
                            <tbody>
                            @foreach (var sh in sendHistory)
                            {
                                <tr>
                                    <td>@if (canSend) { <input type="checkbox" name="sendHistIds" value="@sh.Id" class="form-check-input" /> }</td>
                                    <td><b>@sh.PartyName</b>@if (sh.Remark != null) { <div class="text-muted" style="font-size:11px">@sh.Remark</div> }</td>
                                    <td><span class="badge bg-@(sh.Channel == ChannelType.Email ? "primary" : sh.Channel == ChannelType.Sms ? "info" : "success")">@sh.ChannelLabel</span></td>
                                    <td><span class="badge bg-@(sh.Bulletin == BulletinType.Otp ? "warning text-dark" : "secondary")">@sh.BulletinLabel</span></td>
                                    <td class="small">@(sh.InfoReceive ?? "—")</td>
                                    <td class="small text-muted">@sh.SentAt.ToString("dd/MM/yyyy HH:mm") · @sh.SentBy</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        @if (canSend)
                        {
                            <button class="btn btn-sm btn-outline-primary mt-2"><i class="bi bi-arrow-repeat me-1"></i>Gửi lại các bản tin đã chọn</button>
                        }
                    </form>
                }

                @if (canSend)
                {
                    <form asp-action="AddSendHist" method="post" class="row g-2 mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-3">
                            <select name="partyId" class="form-select form-select-sm">
                                <option value="">— Bên nhận —</option>
                                @foreach (var p in Model.Parties.OrderBy(x => x.SignOrder))
                                {
                                    <option value="@p.Id">@Ui.Role(p.Role): @p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="channel" class="form-select form-select-sm">
                                <option value="0">Email</option>
                                <option value="1">SMS</option>
                                <option value="2">Zalo</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="bulletin" class="form-select form-select-sm">
                                <option value="0">Hợp đồng</option>
                                <option value="1">OTP</option>
                            </select>
                        </div>
                        <div class="col-md-3"><input name="infoReceive" class="form-control form-control-sm" placeholder="Email/SĐT/Zalo (tùy chọn)" /></div>
                        <div class="col-md-2"><input name="remark" class="form-control form-control-sm" placeholder="Ghi chú" /></div>
                        <div class="col-12"><button class="btn btn-sm btn-outline-primary"><i class="bi bi-send me-1"></i>Ghi nhận gửi</button></div>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Thao tác</h6>
                <div class="mb-2 small text-muted">Tiến độ ký: <b>@Model.SignedCount/@Model.Parties.Count</b></div>
                <div class="progress mb-3" style="height:8px">
                    <div class="progress-bar bg-success" style="width:@(Model.Parties.Count == 0 ? 0 : Model.SignedCount * 100 / Model.Parties.Count)%"></div>
                </div>

                @if (Model.Status == ContractStatus.Draft)
                {
                    <form asp-action="Send" method="post" class="mb-2">
                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-primary w-100"><i class="bi bi-send me-1"></i>Gửi các bên ký</button>
                    </form>
                }
                <a href="/Contract/Pdf/@Model.Id" class="btn btn-outline-primary w-100 mb-2" target="_blank"><i class="bi bi-file-pdf me-1"></i>Tải bản thể hiện (PDF)</a>
                @if (!Model.IsAnnex)
                {
                    <a href="/Contract/CreateAnnex/@Model.Id" class="btn btn-outline-info w-100 mb-2"><i class="bi bi-file-earmark-plus me-1"></i>Tạo phụ lục</a>
                }
                @if (Model.Status != ContractStatus.Completed && Model.Status != ContractStatus.Cancelled && Model.Status != ContractStatus.Finished)
                {
                    <form asp-action="Cancel" method="post" onsubmit="return confirm('Hủy hợp đồng này?')">
                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-outline-danger w-100"><i class="bi bi-x-circle me-1"></i>Hủy hợp đồng</button>
                    </form>
                }
                @if (Model.Status != ContractStatus.Cancelled && Model.Status != ContractStatus.Finished)
                {
                    <a href="/Contract/Finish/@Model.Id" class="btn btn-outline-secondary w-100 mt-2"><i class="bi bi-flag me-1"></i>Kết thúc hợp đồng</a>
                }
                @if (Model.Status == ContractStatus.Completed)
                {
                    <div class="alert alert-success small mb-0"><i class="bi bi-check-circle me-1"></i>Hoàn tất lúc @Model.CompletedAt?.ToString("dd/MM/yyyy HH:mm") — đủ chữ ký các bên.</div>
                }
                @if (Model.IsFinished)
                {
                    <div class="alert alert-secondary small mb-0"><i class="bi bi-flag me-1"></i>Đã kết thúc lúc @Model.FinishedAt?.ToString("dd/MM/yyyy HH:mm") — lý do: <b>@Model.FinishReasonName</b>.</div>
                }
            </div>
        </div>
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-clock-history me-1"></i>Nhật ký thao tác <span class="badge bg-secondary">@history.Count</span></h6>
            @if (history.Count == 0)
            {
                <div class="text-muted small">Chưa có thao tác nào.</div>
            }
            else
            {
                <ul class="list-unstyled small mb-0">
                    @foreach (var h in history)
                    {
                        var (ht, hcss, hicon) = Ui.Action(h.Action);
                        <li class="mb-2 d-flex gap-2">
                            <i class="bi @hicon text-@hcss" style="font-size:12px"></i>
                            <div>
                                <span class="badge bg-@hcss">@ht</span>
                                <span class="ms-1">@h.Description</span>
                                <div class="text-muted" style="font-size:11px">@h.Actor · @h.At.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </li>
                    }
                </ul>
            }
            <form asp-action="AddRemark" method="post" class="mt-3 d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input name="remark" class="form-control form-control-sm" placeholder="Ghi chú xử lý…" />
                <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-chat-left-text"></i></button>
            </form>
        </div></div>
    </div>
</div>
