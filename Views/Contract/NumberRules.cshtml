@model List<ContractNumberRule>
@{
    ViewData["Title"] = "Quy tắc đánh số hợp đồng";
    var types = (List<ContractType>)(ViewBag.Types ?? new List<ContractType>());
    var usedTypeIds = Model.Select(r => r.TypeId).ToHashSet();
    var freeTypes = types.Where(t => !usedTypeIds.Contains(t.Id)).ToList();
}

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-123 me-2"></i>Thêm / sửa quy tắc đánh số</h6>
            @if (freeTypes.Count == 0 && Model.Count == 0)
            {
                <div class="text-muted small">Chưa có loại hợp đồng nào để cấu hình.</div>
            }
            else
            {
                <form asp-action="SaveNumberRule" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small text-muted">Loại hợp đồng</label>
                        <select name="typeId" class="form-select" required>
                            <option value="">— Chọn loại —</option>
                            @foreach (var t in types)
                            {
                                <option value="@t.Id">@t.Name @(usedTypeIds.Contains(t.Id) ? "(đã có quy tắc — lưu sẽ ghi đè)" : "")</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Kiểu ghép</label>
                        <select name="typefixCode" class="form-select">
                            <option value="0">Tiền tố — số đứng sau (VD: HD-0001)</option>
                            <option value="1">Hậu tố — số đứng trước (VD: 0001/2026)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Chuỗi tiền/hậu tố</label>
                        <input name="typefixInput" class="form-control" placeholder="VD: HD- hoặc /2026" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small text-muted">Độ dài số</label>
                            <input name="seqNumberLength" type="number" min="1" max="12" value="4" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted">Số bắt đầu</label>
                            <input name="numberStart" type="number" min="1" value="1" class="form-control" />
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="active" value="true" id="activeChk" checked />
                        <label class="form-check-label small" for="activeChk">Đang áp dụng</label>
                    </div>
                    <button class="btn btn-primary w-100"><i class="bi bi-save me-1"></i>Lưu quy tắc</button>
                </form>
            }
            <p class="text-muted small mt-3 mb-0">Quy tắc sinh số hợp đồng theo loại — port từ <code>Mst_ContractTypeContractNo</code> + <code>Seq_ContractNo_Get</code> (QContract). Khi tạo hợp đồng, số sẽ được sinh tự động theo quy tắc của loại.</p>
        </div></div>
    </div>
    <div class="col-lg-7">
        <div class="card"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-list-ul me-2"></i>Quy tắc hiện có <span class="badge bg-secondary">@Model.Count</span></h6>
            </div>
            @if (Model.Count == 0)
            {
                <div class="text-muted small">Chưa có quy tắc đánh số nào.</div>
            }
            else
            {
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Loại hợp đồng</th><th>Kiểu</th><th>Tiền/hậu tố</th><th>Độ dài</th><th>Bắt đầu</th><th>Ví dụ</th><th>Hiệu lực</th></tr></thead>
                    <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@(r.Type?.Name ?? $"#{r.TypeId}")</td>
                            <td><span class="badge bg-@(r.TypefixCode == Typefix.Postfix ? "info" : "primary")">@r.TypefixLabel</span></td>
                            <td><code>@(string.IsNullOrEmpty(r.TypefixInput) ? "—" : r.TypefixInput)</code></td>
                            <td>@r.SeqNumberLength</td>
                            <td>@r.NumberStart</td>
                            <td class="small text-muted">@r.Build(r.NumberStart)</td>
                            <td>@if (r.Active) { <span class="badge bg-success">Đang dùng</span> } else { <span class="badge bg-secondary">Ngừng</span> }</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div></div>
    </div>
</div>