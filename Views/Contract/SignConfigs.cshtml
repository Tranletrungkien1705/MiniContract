@model List<OrgSignConfig>
@{
    ViewData["Title"] = "Cấu hình ký của tổ chức";
    var active = Model.Count(c => c.Active);
    var remote = Model.Count(c => c.SignType == SignType.Remote);
    var server = Model.Count(c => c.SignType == SignType.Server);
}

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-sliders fs-3 text-primary"></i>
            <div><div class="stat-num">@Model.Count</div><div class="text-muted small">Tổng cấu hình</div></div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-check-circle fs-3 text-success"></i>
            <div><div class="stat-num">@active</div><div class="text-muted small">Đang hiệu lực</div></div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-cloud-arrow-up fs-3 text-info"></i>
            <div><div class="stat-num">@remote</div><div class="text-muted small">Ký từ xa</div></div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-hdd-network fs-3 text-warning"></i>
            <div><div class="stat-num">@server</div><div class="text-muted small">Ký server</div></div>
        </div></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-plus-square me-2"></i>Thêm / sửa cấu hình ký</h6>
            <form asp-action="SaveSignConfig" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="0" />
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small text-muted">Loại ký (SignType) <span class="text-danger">*</span></label>
                        <select name="signType" class="form-select">
                            <option value="0">Ký từ xa (REMOTE)</option>
                            <option value="1">Ký server (SERVER)</option>
                            <option value="2">USB Token</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Mã tổ chức (OrgID) <span class="text-danger">*</span></label>
                        <input name="orgCode" class="form-control" placeholder="VD: HTC" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">NetworkID</label>
                    <input name="networkId" class="form-control" placeholder="VD: NET-HTC" />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small text-muted">Số chứng thư (CANumber)</label>
                        <input name="caNumber" class="form-control" placeholder="VD: 0101234567-001" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Nhà cung cấp CA (CAOrg)</label>
                        <input name="caOrg" class="form-control" placeholder="VD: VNPT-CA" />
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small text-muted">Hiệu lực từ</label>
                        <input name="effectiveFrom" type="date" class="form-control" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Hiệu lực đến</label>
                        <input name="effectiveTo" type="date" class="form-control" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Ký server — đường dẫn file (ServerSignFilePath)</label>
                    <input name="serverSignFilePath" class="form-control" placeholder="VD: /sign/server.pfx" />
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Ký server — mật khẩu (ServerSignPassword)</label>
                    <input name="serverSignPassword" type="password" class="form-control" placeholder="••••••" />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small text-muted">Nhà cung cấp ký từ xa (SupplierCode)</label>
                        <input name="supplierCode" class="form-control" placeholder="VD: EFY" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Hình thức xác thực (AuthenCode)</label>
                        <input name="authenCode" class="form-control" placeholder="VD: OTP" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Mã hợp đồng ký từ xa (RemoteSignAgreementUUID)</label>
                    <input name="remoteSignAgreementUUID" class="form-control" placeholder="VD: 8f3c…" />
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Mã ký từ xa (RemoteSignPassCode)</label>
                    <input name="remoteSignPassCode" type="password" class="form-control" placeholder="••••••" />
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="active" value="true" id="activeChk" checked />
                    <label class="form-check-label small" for="activeChk">Đang hiệu lực</label>
                </div>
                <button class="btn btn-primary w-100"><i class="bi bi-save me-1"></i>Lưu cấu hình ký</button>
            </form>
            <p class="text-muted small mt-3 mb-0">Cấu hình ký của tổ chức — port từ <code>Mst_OrgSignConfig</code> (QContract). Với mỗi cặp <code>(SignType, OrgID)</code> chỉ được có <b>tối đa 1</b> cấu hình đang hiệu lực.</p>
        </div></div>
    </div>
    <div class="col-lg-7">
        <div class="card"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-list-ul me-2"></i>Cấu hình hiện có <span class="badge bg-secondary">@Model.Count</span></h6>
            </div>
            @if (Model.Count == 0)
            {
                <div class="text-muted small">Chưa có cấu hình ký nào.</div>
            }
            else
            {
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Loại ký</th><th>Tổ chức</th><th>Chứng thư</th><th>Hiệu lực</th><th>Trạng thái</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@c.SignTypeLabel</td>
                            <td><code>@c.OrgCode</code></td>
                            <td class="small text-muted">@(string.IsNullOrWhiteSpace(c.CANumber) ? "—" : c.CANumber)</td>
                            <td class="small text-muted">@c.ValidityLabel</td>
                            <td>
                                @if (c.Active) { <span class="badge bg-success">Đang hiệu lực</span> }
                                else { <span class="badge bg-secondary">Ngừng hiệu lực</span> }
                            </td>
                            <td class="text-end">
                                <form asp-action="DeleteSignConfig" method="post" onsubmit="return confirm('Xóa cấu hình ký @c.SignTypeLabel của @c.OrgCode?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div></div>
    </div>
</div>
