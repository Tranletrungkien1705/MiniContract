@{
    ViewData["Title"] = "Tạo phụ lục hợp đồng";
    var parent = (Contract)ViewBag.Parent;
}

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-info">Phụ lục</span>
            <div>
                <div class="fw-semibold">Phụ lục của hợp đồng <span class="text-primary">@parent.Code</span></div>
                <div class="text-muted small">@parent.Title · giá trị gốc @parent.Value.ToString("N0") đ</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="CreateAnnex" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@parent.Id" />
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label small text-muted">Tiêu đề phụ lục *</label>
                    <input name="title" class="form-control" placeholder="VD: Phụ lục 01 — điều chỉnh giá trị hợp đồng" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted">Giá trị điều chỉnh (đ)</label>
                    <input name="value" type="number" step="1000" value="0" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label small text-muted">Nội dung phụ lục</label>
                    <textarea name="body" class="form-control" rows="4" placeholder="Nội dung điều chỉnh/bổ sung so với hợp đồng gốc..."></textarea>
                </div>
            </div>

            <hr class="my-4" />
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="fw-semibold mb-2"><span class="badge bg-secondary me-1">Bên A</span></div>
                    <input name="partyAName" class="form-control mb-2" value="@parent.Parties.FirstOrDefault(p => p.Role == PartyRole.PartyA)?.Name" placeholder="Tên Bên A *" required />
                    <input name="partyAEmail" type="email" class="form-control" value="@parent.Parties.FirstOrDefault(p => p.Role == PartyRole.PartyA)?.Email" placeholder="Email Bên A" />
                </div>
                <div class="col-md-6">
                    <div class="fw-semibold mb-2"><span class="badge bg-secondary me-1">Bên B</span></div>
                    <input name="partyBName" class="form-control mb-2" value="@parent.Parties.FirstOrDefault(p => p.Role == PartyRole.PartyB)?.Name" placeholder="Tên Bên B *" required />
                    <input name="partyBEmail" type="email" class="form-control" value="@parent.Parties.FirstOrDefault(p => p.Role == PartyRole.PartyB)?.Email" placeholder="Email Bên B" />
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Tạo phụ lục nháp</button>
                <a href="/Contract/Detail/@parent.Id" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
