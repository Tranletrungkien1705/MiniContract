@model List<ContractType>
@{
    ViewData["Title"] = "Loại hợp đồng";
    var list = Model ?? new();
    var total = list.Count;
    var active = list.Count(t => t.Active);
    var inUse = list.Count(t => t.InUse);
}

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-tags fs-3 text-primary"></i>
            <div><div class="stat-num">@total</div><div class="text-muted small">Tổng loại hợp đồng</div></div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-check-circle fs-3 text-success"></i>
            <div><div class="stat-num">@active</div><div class="text-muted small">Đang hiệu lực</div></div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-link-45deg fs-3 text-info"></i>
            <div><div class="stat-num">@inUse</div><div class="text-muted small">Đang được sử dụng</div></div>
        </div></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-plus-square me-2"></i>Thêm loại hợp đồng</h6>
            <form asp-action="SaveContractType" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="0" />
                <div class="mb-2">
                    <label class="form-label small text-muted">Mã loại (ContractType) <span class="text-danger">*</span></label>
                    <input name="code" class="form-control" placeholder="VD: MB" required />
                </div>
                <div class="mb-2">
                    <label class="form-label small text-muted">Tên loại (ContractTypeName) <span class="text-danger">*</span></label>
                    <input name="name" class="form-control" placeholder="VD: Hợp đồng mua bán" required />
                </div>
                <div class="mb-2">
                    <label class="form-label small text-muted">Mô tả (Description)</label>
                    <input name="description" class="form-control" placeholder="Mô tả ngắn về loại hợp đồng" />
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="active" value="true" id="ctActive" checked />
                    <label class="form-check-label small" for="ctActive">Đang hiệu lực (FlagActive)</label>
                </div>
                <button class="btn btn-primary w-100"><i class="bi bi-save me-1"></i>Lưu loại hợp đồng</button>
            </form>
            <p class="text-muted small mt-3 mb-0">Danh mục loại hợp đồng — port từ <code>Mst_ContractType</code> (QContract). Mã loại không được trùng; tên bắt buộc; <strong>không xóa</strong> loại đang được hợp đồng mẫu hoặc hợp đồng sử dụng.</p>
        </div></div>
    </div>

    <div class="col-lg-7">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-list-ul me-2"></i>Danh mục loại hợp đồng <span class="badge bg-secondary">@total</span></h6>
            @if (total == 0)
            {
                <div class="text-muted small">Chưa có loại hợp đồng nào.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Mã</th><th>Tên</th><th>Mô tả</th>
                                <th class="text-center">Mẫu</th><th class="text-center">HĐ</th>
                                <th>Trạng thái</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var t in list)
                        {
                            <tr>
                                <td><code>@t.Code</code></td>
                                <td class="small fw-semibold">@t.Name</td>
                                <td class="small text-muted">@(string.IsNullOrWhiteSpace(t.Description) ? "—" : t.Description)</td>
                                <td class="text-center small">@t.TemplateCount</td>
                                <td class="text-center small">@t.ContractCount</td>
                                <td>
                                    @if (t.Active)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis">@t.ActiveLabel</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis">@t.ActiveLabel</span>
                                    }
                                    @if (t.InUse)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis">Đang dùng</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (t.InUse)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" disabled title="Loại đang được sử dụng — không thể xóa"><i class="bi bi-trash"></i></button>
                                    }
                                    else
                                    {
                                        <form asp-action="DeleteContractType" method="post" onsubmit="return confirm('Xóa loại hợp đồng @t.Name?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@t.Id" />
                                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div></div>
    </div>
</div>
