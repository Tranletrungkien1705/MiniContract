@model List<CurrencyExchange>
@{
    ViewData["Title"] = "Tỷ giá ngoại tệ";
    var list = Model ?? new();
    var total = list.Count;
    var withRate = list.Count(c => c.HasRate);
    var bases = list.Where(c => !string.IsNullOrWhiteSpace(c.BaseCurrencyCode))
                    .Select(c => c.BaseCurrencyCode!).Distinct().Count();
}

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-currency-exchange fs-3 text-primary"></i>
            <div><div class="stat-num">@total</div><div class="text-muted small">Tổng loại ngoại tệ</div></div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-graph-up-arrow fs-3 text-success"></i>
            <div><div class="stat-num">@withRate</div><div class="text-muted small">Đã có tỷ giá</div></div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-cash-stack fs-3 text-info"></i>
            <div><div class="stat-num">@bases</div><div class="text-muted small">Đồng tiền gốc</div></div>
        </div></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-plus-square me-2"></i>Thêm tỷ giá ngoại tệ</h6>
            <form asp-action="SaveCurrency" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="0" />
                <div class="mb-2">
                    <label class="form-label small text-muted">Mã ngoại tệ (CurrencyCode) <span class="text-danger">*</span></label>
                    <input name="currencyCode" class="form-control" placeholder="VD: USD" required />
                </div>
                <div class="mb-2">
                    <label class="form-label small text-muted">Tên ngoại tệ (CurrencyName) <span class="text-danger">*</span></label>
                    <input name="currencyName" class="form-control" placeholder="VD: Đô la Mỹ" required />
                </div>
                <div class="mb-2">
                    <label class="form-label small text-muted">Đồng tiền gốc (BaseCurrencyCode)</label>
                    <input name="baseCurrencyCode" class="form-control" placeholder="VD: VND" />
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-4">
                        <label class="form-label small text-muted">Tỷ giá mua</label>
                        <input name="buyRate" type="number" step="0.0001" value="0" class="form-control" />
                    </div>
                    <div class="col-4">
                        <label class="form-label small text-muted">Tỷ giá bán</label>
                        <input name="sellRate" type="number" step="0.0001" value="0" class="form-control" />
                    </div>
                    <div class="col-4">
                        <label class="form-label small text-muted">Quy đổi (InterEx)</label>
                        <input name="interEx" type="number" step="0.0001" value="0" class="form-control" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Ghi chú</label>
                    <input name="remark" class="form-control" />
                </div>
                <button class="btn btn-primary w-100"><i class="bi bi-save me-1"></i>Lưu tỷ giá</button>
            </form>
            <p class="text-muted small mt-3 mb-0">Danh mục tỷ giá ngoại tệ — port từ <code>Mst_CurrencyEx</code> (QContract). Mã ngoại tệ không được trùng; tên bắt buộc; nếu có đồng tiền gốc thì đồng tiền gốc phải tồn tại.</p>
        </div></div>
    </div>

    <div class="col-lg-7">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-list-ul me-2"></i>Danh mục tỷ giá <span class="badge bg-secondary">@total</span></h6>
            @if (total == 0)
            {
                <div class="text-muted small">Chưa có tỷ giá ngoại tệ nào.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Mã</th><th>Tên</th><th>Đồng gốc</th>
                                <th class="text-end">Mua</th><th class="text-end">Bán</th><th class="text-end">Quy đổi</th>
                                <th>Cập nhật</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var c in list)
                        {
                            <tr>
                                <td><code>@c.CurrencyCode</code></td>
                                <td class="small">
                                    @c.CurrencyName
                                    @if (!string.IsNullOrWhiteSpace(c.Remark))
                                    {
                                        <div class="text-muted">@c.Remark</div>
                                    }
                                </td>
                                <td class="small">@c.BaseLabel</td>
                                <td class="text-end small">@c.BuyRate.ToString("N0")</td>
                                <td class="text-end small">@c.SellRate.ToString("N0")</td>
                                <td class="text-end small">@c.InterEx.ToString("N0")</td>
                                <td class="small text-muted">@(c.UpdatedTime?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                <td class="text-end">
                                    <form asp-action="DeleteCurrency" method="post" onsubmit="return confirm('Xóa tỷ giá @c.CurrencyCode?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div></div>
    </div>
</div>
