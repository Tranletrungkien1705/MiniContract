@model List<SubmissionForm>
@{
    ViewData["Title"] = "Mẫu nội dung gửi";
    var forms = Model ?? new();
    var total = forms.Count;
    var active = forms.Count(f => f.Active);
    var email = forms.Count(f => f.ChannelType == ChannelType.Email);
    var zalo = forms.Count(f => f.ChannelType == ChannelType.Zalo);
}

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-file-earmark-richtext fs-3 text-primary"></i>
            <div><div class="stat-num">@total</div><div class="text-muted small">Tổng mẫu gửi</div></div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-check-circle fs-3 text-success"></i>
            <div><div class="stat-num">@active</div><div class="text-muted small">Đang hiệu lực</div></div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-envelope fs-3 text-info"></i>
            <div><div class="stat-num">@email</div><div class="text-muted small">Mẫu qua Email</div></div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-chat-square-text fs-3 text-warning"></i>
            <div><div class="stat-num">@zalo</div><div class="text-muted small">Mẫu qua Zalo</div></div>
        </div></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-plus-square me-2"></i>Thêm mẫu nội dung gửi</h6>
            <form asp-action="SaveSubmissionForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="0" />
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small text-muted">Mã mẫu (SubFormCode) <span class="text-danger">*</span></label>
                        <input name="subFormCode" class="form-control" placeholder="MAIL-HD" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Tên mẫu <span class="text-danger">*</span></label>
                        <input name="subFormName" class="form-control" placeholder="Mẫu gửi hợp đồng qua Email" required />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small text-muted">Kênh gửi</label>
                        <select name="channelType" class="form-select">
                            <option value="0">Email</option>
                            <option value="1">SMS</option>
                            <option value="2">Zalo</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Loại bản tin</label>
                        <select name="bulletinType" class="form-select">
                            <option value="0">Hợp đồng</option>
                            <option value="1">OTP</option>
                        </select>
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small text-muted">Mã mẫu ZNS (IDZNS)</label>
                    <input name="idZns" class="form-control" placeholder="VD: 123456 (chỉ dùng khi gửi qua Zalo)" />
                </div>
                <div class="mb-2">
                    <label class="form-label small text-muted">Nội dung mẫu <span class="text-muted">(mỗi dòng: <code>tiêu đề | nội dung</code>)</span></label>
                    <textarea name="messages" class="form-control" rows="3" placeholder="Thông báo ký hợp đồng | Kính gửi {TenBen}, vui lòng ký hợp đồng {SoHopDong}."></textarea>
                </div>
                <div class="mb-2">
                    <label class="form-label small text-muted">Tham số ZNS <span class="text-muted">(mỗi dòng: <code>mã ZNS | nguồn | mã tham số | giá trị</code>)</span></label>
                    <textarea name="znsParams" class="form-control" rows="2" placeholder="customer_name | Contract | TenBen | {TenBen}"></textarea>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="active" value="true" id="activeChk" checked />
                    <label class="form-check-label small" for="activeChk">Đang hiệu lực</label>
                </div>
                <button class="btn btn-primary w-100"><i class="bi bi-save me-1"></i>Lưu mẫu gửi</button>
            </form>
            <p class="text-muted small mt-3 mb-0">Mẫu nội dung gửi — port từ <code>Mst_SubmissionForm</code> (QContract). Mã mẫu dùng làm <code>SubFormCodeEmailContract/OTP</code> trong cấu hình kênh gửi.</p>
        </div></div>
    </div>
    <div class="col-lg-7">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-list-ul me-2"></i>Danh mục mẫu gửi</h6>
            @if (total == 0)
            {
                <div class="text-muted small">Chưa có mẫu nội dung gửi nào.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Mã mẫu</th><th>Tên mẫu</th><th>Kênh</th><th>Bản tin</th>
                                <th class="text-center">Nội dung</th><th class="text-center">ZNS</th><th>Trạng thái</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var f in forms)
                        {
                            <tr>
                                <td><code>@f.SubFormCode</code></td>
                                <td class="small">@f.SubFormName</td>
                                <td><span class="badge bg-info">@f.ChannelLabel</span></td>
                                <td><span class="badge bg-secondary">@f.BulletinLabel</span></td>
                                <td class="text-center small">@f.MessageCount</td>
                                <td class="text-center small">@f.ZnsParamCount</td>
                                <td>
                                    @if (f.Active) { <span class="badge bg-success">Hiệu lực</span> }
                                    else { <span class="badge bg-secondary">Ngừng</span> }
                                </td>
                                <td class="text-end">
                                    <form asp-action="DeleteSubmissionForm" method="post" onsubmit="return confirm('Xóa mẫu gửi @f.SubFormCode?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@f.Id" />
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div></div>
    </div>
</div>
