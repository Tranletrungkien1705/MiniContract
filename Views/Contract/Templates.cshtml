@model List<ContractTemplate>
@{
    ViewData["Title"] = "Hợp đồng mẫu";
    var types = (List<ContractType>)ViewBag.Types;
}

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-plus-square me-2"></i>Thêm hợp đồng mẫu</h6>
            <form asp-action="SaveTemplate" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="0" />
                <div class="mb-3">
                    <label class="form-label small text-muted">Tên mẫu</label>
                    <input name="name" class="form-control" placeholder="VD: Hợp đồng mua bán hàng hóa" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Loại hợp đồng</label>
                    <select name="typeId" class="form-select">
                        <option value="">— Không chọn —</option>
                        @foreach (var t in types)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Nội dung mẫu</label>
                    <textarea name="body" class="form-control" rows="4" placeholder="Nội dung hợp đồng mẫu…"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Ghi chú (tùy chọn)</label>
                    <input name="remark" class="form-control" />
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="active" value="true" checked />
                    <label class="form-check-label small">Đang hiệu lực</label>
                </div>
                <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Thêm mẫu</button>
            </form>
            <p class="text-muted small mt-3 mb-0">Mẫu dùng để <b>soạn nhanh hợp đồng</b> — port từ <code>Contract_TempContract</code> (QContract).</p>
        </div></div>
    </div>
    <div class="col-lg-7">
        <div class="card"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-list-ul me-2"></i>Danh mục mẫu <span class="badge bg-secondary">@Model.Count</span></h6>
            </div>
            @if (Model.Count == 0)
            {
                <div class="text-muted small">Chưa có hợp đồng mẫu nào.</div>
            }
            else
            {
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Mã</th><th>Tên mẫu</th><th>Loại</th><th>Hiệu lực</th><th class="text-end">Thao tác</th></tr></thead>
                    <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@t.Code</td>
                            <td>@t.Name</td>
                            <td class="small text-muted">@t.TypeName</td>
                            <td>@if (t.Active) { <span class="badge bg-success">Đang dùng</span> } else { <span class="badge bg-secondary">Ngừng</span> }</td>
                            <td class="text-end">
                                <a href="/Contract/CreateFromTemplate/@t.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-file-earmark-plus me-1"></i>Soạn HĐ</a>
                                <form asp-action="DeleteTemplate" method="post" class="d-inline" onsubmit="return confirm('Xóa mẫu @t.Name?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div></div>
    </div>
</div>
