@model ChannelConfig?
@{
    ViewData["Title"] = "Cấu hình kênh gửi";
    var cfg = Model;
    var has = cfg != null;
}

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-broadcast fs-3 text-primary"></i>
            <div><div class="stat-num">@(has ? 1 : 0)</div><div class="text-muted small">Cấu hình kênh</div></div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-file-earmark-text fs-3 text-info"></i>
            <div><div class="stat-num">@(cfg?.ContractChannelLabel ?? "—")</div><div class="text-muted small">Kênh gửi hợp đồng</div></div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-shield-check fs-3 text-warning"></i>
            <div><div class="stat-num">@(cfg?.OtpChannelLabel ?? "—")</div><div class="text-muted small">Kênh gửi OTP</div></div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-key fs-3 text-success"></i>
            <div><div class="stat-num">@(cfg?.AccessKeyChannelLabel ?? "—")</div><div class="text-muted small">Kênh gửi AccessKey</div></div>
        </div></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-sliders me-2"></i>@(has ? "Cập nhật" : "Thêm") cấu hình kênh gửi</h6>
            <form asp-action="SaveChannelConfig" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@(cfg?.Id ?? 0)" />

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small text-muted">Kênh gửi hợp đồng <span class="text-danger">*</span></label>
                        <select name="contractChannel" class="form-select">
                            <option value="0" selected="@(cfg?.ContractChannel == ChannelType.Email)">Email</option>
                            <option value="1" selected="@(cfg?.ContractChannel == ChannelType.Sms)">SMS</option>
                            <option value="2" selected="@(cfg?.ContractChannel == ChannelType.Zalo)">Zalo</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Kênh gửi OTP <span class="text-danger">*</span></label>
                        <select name="otpChannel" class="form-select">
                            <option value="0" selected="@(cfg?.OtpChannel == ChannelType.Email)">Email</option>
                            <option value="1" selected="@(cfg?.OtpChannel == ChannelType.Sms)">SMS</option>
                            <option value="2" selected="@(cfg?.OtpChannel == ChannelType.Zalo)">Zalo</option>
                        </select>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">NetworkID</label>
                    <input name="networkId" class="form-control" value="@cfg?.NetworkID" placeholder="VD: NET-HTC" />
                </div>

                <hr />
                <h6 class="fw-semibold small text-uppercase text-muted mb-2"><i class="bi bi-envelope me-1"></i>Kênh Email</h6>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small text-muted">MailFrom</label>
                        <input name="mailFrom" class="form-control" value="@cfg?.Email?.MailFrom" placeholder="no-reply@corp.vn" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Tên hiển thị</label>
                        <input name="displayNameMailFrom" class="form-control" value="@cfg?.Email?.DisplayNameMailFrom" placeholder="Hợp đồng điện tử" />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small text-muted">APIsSendMail</label>
                        <input name="apisSendMail" class="form-control" value="@cfg?.Email?.APIsSendMail" placeholder="https://mail-gw/api/send" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">ApiKeySendMail</label>
                        <input name="apiKeySendMail" type="password" class="form-control" value="@cfg?.Email?.ApiKeySendMail" placeholder="••••••" />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small text-muted">SolutionCodeSendMail</label>
                        <input name="solutionCodeSendMail" class="form-control" value="@cfg?.Email?.SolutionCodeSendMail" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Mẫu nội dung gửi HĐ</label>
                        <input name="subFormCodeEmailContract" class="form-control" value="@cfg?.Email?.SubFormCodeEmailContract" placeholder="MAIL-HD" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Mẫu nội dung gửi OTP</label>
                    <input name="subFormCodeEmailOtp" class="form-control" value="@cfg?.Email?.SubFormCodeEmailOtp" placeholder="MAIL-OTP" />
                </div>

                <hr />
                <h6 class="fw-semibold small text-uppercase text-muted mb-2"><i class="bi bi-chat-dots me-1"></i>Kênh SMS</h6>
                <div class="row g-2 mb-3">
                    <div class="col-4">
                        <label class="form-label small text-muted">SMSBrandName</label>
                        <input name="smsBrandName" class="form-control" value="@cfg?.Sms?.SmsBrandName" placeholder="HTC" />
                    </div>
                    <div class="col-4">
                        <label class="form-label small text-muted">Mẫu nội dung gửi HĐ</label>
                        <input name="subFormCodeContractSms" class="form-control" value="@cfg?.Sms?.SubFormCodeContractSms" placeholder="SMS-HD" />
                    </div>
                    <div class="col-4">
                        <label class="form-label small text-muted">Mẫu nội dung gửi OTP</label>
                        <input name="subFormCodeSmsOtp" class="form-control" value="@cfg?.Sms?.SubFormCodeSmsOtp" placeholder="SMS-OTP" />
                    </div>
                </div>

                <hr />
                <h6 class="fw-semibold small text-uppercase text-muted mb-2"><i class="bi bi-chat-square-text me-1"></i>Kênh Zalo</h6>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small text-muted">ZaloOAID</label>
                        <input name="zaloOaId" class="form-control" value="@cfg?.Zalo?.ZaloOaId" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">AppID</label>
                        <input name="appId" class="form-control" value="@cfg?.Zalo?.AppId" />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small text-muted">AccessToken</label>
                        <input name="accessToken" type="password" class="form-control" value="@cfg?.Zalo?.AccessToken" placeholder="••••••" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">RefreshToken</label>
                        <input name="refreshToken" type="password" class="form-control" value="@cfg?.Zalo?.RefreshToken" placeholder="••••••" />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small text-muted">AppSecret</label>
                        <input name="appSecret" type="password" class="form-control" value="@cfg?.Zalo?.AppSecret" placeholder="••••••" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Mẫu nội dung gửi HĐ (ZaloUserId)</label>
                        <input name="subFormCodeContractZaloUserId" class="form-control" value="@cfg?.Zalo?.SubFormCodeContractZaloUserId" placeholder="ZALO-HD" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Mẫu nội dung gửi OTP</label>
                    <input name="subFormCodeOtp" class="form-control" value="@cfg?.Zalo?.SubFormCodeOtp" placeholder="ZALO-OTP" />
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="active" value="true" id="activeChk" checked="@(cfg?.Active ?? true)" />
                    <label class="form-check-label small" for="activeChk">Đang hiệu lực</label>
                </div>
                <button class="btn btn-primary w-100"><i class="bi bi-save me-1"></i>Lưu cấu hình kênh gửi</button>
            </form>
            <p class="text-muted small mt-3 mb-0">Cấu hình kênh gửi của tổ chức — port từ <code>Mst_Channel</code> (QContract). Mỗi tổ chức có <b>1</b> cấu hình kênh; kênh AccessKey luôn là <b>Email</b>.</p>
        </div></div>
    </div>
    <div class="col-lg-5">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-list-ul me-2"></i>Cấu hình hiện có</h6>
            @if (!has)
            {
                <div class="text-muted small">Chưa có cấu hình kênh gửi nào.</div>
            }
            else
            {
                <table class="table table-sm align-middle mb-0">
                    <tbody>
                        <tr><th class="text-muted small">Kênh gửi HĐ</th><td><span class="badge bg-info">@cfg!.ContractChannelLabel</span></td></tr>
                        <tr><th class="text-muted small">Kênh gửi OTP</th><td><span class="badge bg-warning text-dark">@cfg.OtpChannelLabel</span></td></tr>
                        <tr><th class="text-muted small">Kênh AccessKey</th><td><span class="badge bg-success">@cfg.AccessKeyChannelLabel</span></td></tr>
                        <tr><th class="text-muted small">NetworkID</th><td><code>@(string.IsNullOrWhiteSpace(cfg.NetworkID) ? "—" : cfg.NetworkID)</code></td></tr>
                        <tr><th class="text-muted small">Email</th><td class="small text-muted">@(cfg.HasEmail ? (string.IsNullOrWhiteSpace(cfg.Email!.MailFrom) ? "đã cấu hình" : cfg.Email!.MailFrom) : "—")</td></tr>
                        <tr><th class="text-muted small">SMS</th><td class="small text-muted">@(cfg.HasSms ? (string.IsNullOrWhiteSpace(cfg.Sms!.SmsBrandName) ? "đã cấu hình" : cfg.Sms!.SmsBrandName) : "—")</td></tr>
                        <tr><th class="text-muted small">Zalo</th><td class="small text-muted">@(cfg.HasZalo ? (string.IsNullOrWhiteSpace(cfg.Zalo!.ZaloOaId) ? "đã cấu hình" : cfg.Zalo!.ZaloOaId) : "—")</td></tr>
                        <tr><th class="text-muted small">Trạng thái</th><td>
                            @if (cfg.Active) { <span class="badge bg-success">Đang hiệu lực</span> }
                            else { <span class="badge bg-secondary">Ngừng hiệu lực</span> }
                        </td></tr>
                    </tbody>
                </table>
                <form asp-action="DeleteChannelConfig" method="post" class="mt-3" onsubmit="return confirm('Xóa cấu hình kênh gửi?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@cfg.Id" />
                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Xóa cấu hình kênh</button>
                </form>
            }
        </div></div>
    </div>
</div>
