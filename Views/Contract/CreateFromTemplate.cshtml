@{
    ViewData["Title"] = "Soạn hợp đồng từ mẫu";
    var t = (ContractTemplate)ViewBag.Template;
}

<div class="card">
    <div class="card-body">
        <div class="alert alert-info d-flex align-items-center mb-4">
            <i class="bi bi-file-earmark-text me-2"></i>
            <div>
                Soạn từ mẫu <b>@t.Name</b> <span class="badge bg-secondary ms-1">@t.Code</span>
                @if (t.Type != null) { <span class="text-muted">— loại: @t.Type.Name</span> }
            </div>
        </div>
        <form asp-action="CreateFromTemplate" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@t.Id" />
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label small text-muted">Tiêu đề hợp đồng</label>
                    <input name="title" class="form-control" value="@t.Name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted">Giá trị (đ)</label>
                    <input name="value" type="number" step="1000" value="0" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label small text-muted">Nội dung (mặc định lấy từ mẫu)</label>
                    <textarea name="body" class="form-control" rows="5">@t.Body</textarea>
                </div>
            </div>

            <hr class="my-4" />
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="fw-semibold mb-2"><span class="badge bg-secondary me-1">Bên A</span> (bên đề nghị)</div>
                    <input name="partyAName" class="form-control mb-2" placeholder="Tên Bên A *" required />
                    <input name="partyAEmail" type="email" class="form-control" placeholder="Email Bên A" />
                </div>
                <div class="col-md-6">
                    <div class="fw-semibold mb-2"><span class="badge bg-secondary me-1">Bên B</span> (bên nhận)</div>
                    <input name="partyBName" class="form-control mb-2" placeholder="Tên Bên B *" required />
                    <input name="partyBEmail" type="email" class="form-control" placeholder="Email Bên B" />
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Tạo hợp đồng nháp</button>
                <a href="/Contract/Templates" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
