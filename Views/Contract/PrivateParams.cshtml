@model List<PrivateParam>
@{
    ViewData["Title"] = "Tham số riêng";
    var items = Model ?? new();
    var total = items.Count;
    var withValue = items.Count(p => p.HasValue);
    var withNetwork = items.Count(p => !string.IsNullOrWhiteSpace(p.NetworkID));
}

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-key fs-3 text-primary"></i>
            <div><div class="stat-num">@total</div><div class="text-muted small">Tổng tham số riêng</div></div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-check-circle fs-3 text-success"></i>
            <div><div class="stat-num">@withValue</div><div class="text-muted small">Đã có giá trị</div></div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-diagram-3 fs-3 text-info"></i>
            <div><div class="stat-num">@withNetwork</div><div class="text-muted small">Gắn theo mạng</div></div>
        </div></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-plus-square me-2"></i>Thêm tham số riêng</h6>
            <form asp-action="SavePrivateParam" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="0" />
                <div class="mb-2">
                    <label class="form-label small text-muted">Mã tham số (ParamCode) <span class="text-danger">*</span></label>
                    <input name="paramCode" class="form-control" placeholder="VD: PRIVATE_SIGN_PASSWORD" required />
                </div>
                <div class="mb-2">
                    <label class="form-label small text-muted">Mạng áp dụng (NetworkID)</label>
                    <input name="networkId" class="form-control" placeholder="VD: NET-HTC" />
                </div>
                <div class="mb-2">
                    <label class="form-label small text-muted">Giá trị (ParamValue)</label>
                    <textarea name="paramValue" class="form-control" rows="2" placeholder="VD: ******"></textarea>
                </div>
                <button class="btn btn-primary w-100"><i class="bi bi-save me-1"></i>Lưu tham số</button>
            </form>
            <p class="text-muted small mt-3 mb-0">Danh mục tham số riêng theo mạng — port từ <code>Mst_ParamPrivate</code> (QContract). Mã tham số không được trùng; khi sửa chỉ cập nhật giá trị/mạng.</p>
        </div></div>
    </div>

    <div class="col-lg-7">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-list-ul me-2"></i>Danh mục tham số riêng <span class="badge bg-secondary">@total</span></h6>
            @if (total == 0)
            {
                <div class="text-muted small">Chưa có tham số riêng nào.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Mã tham số</th><th>Mạng</th><th>Giá trị</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var p in items)
                        {
                            <tr>
                                <td><code>@p.ParamCode</code></td>
                                <td class="small">
                                    @if (!string.IsNullOrWhiteSpace(p.NetworkID)) { <span class="badge bg-info">@p.NetworkID</span> }
                                    else { <span class="badge bg-secondary">—</span> }
                                </td>
                                <td class="small">
                                    @if (p.HasValue) { <span>@p.ParamValue</span> }
                                    else { <span class="text-muted">(rỗng)</span> }
                                </td>
                                <td class="text-end">
                                    <form asp-action="DeletePrivateParam" method="post" onsubmit="return confirm('Xóa tham số @p.ParamCode?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div></div>
    </div>
</div>
